---
// Same look as https://www.vaulthuman.com/key/b003/: dark green ground, ink, gold, Bebas Neue titles, Inter body.
interface Props { title: string; nav?: string }
const { title, nav } = Astro.props;
const member = Astro.locals.member;
const tabs = [
  ['today', '/today', 'Today'],
  ['keys', '/keys', 'My keys'],
  ['progress', '/progress', 'Progress'],
  ['downloads', '/downloads', 'Downloads'],
  ['membership', '/membership', 'Membership'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title} · Vault Human</title>
  <link rel="icon" type="image/png" sizes="32x32" href="https://www.vaulthuman.com/favicon-32.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" />
  <style is:global>
    :root{--bg:#141A16;--bg2:#1A2420;--ink:#F1EDE4;--soft:#CFC9BC;--mute:#8E9A90;--acc:#C9A24A;--green:#8FA67E;--line:rgba(241,237,228,.14);--disp:'Bebas Neue',Inter,sans-serif}
    *{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}
    .wrap{max-width:760px;margin:0 auto;padding:0 20px}
    .top{display:flex;justify-content:space-between;align-items:baseline;padding:18px 20px 0;max-width:760px;margin:0 auto}
    .brand{font-family:var(--disp);font-size:34px;letter-spacing:2px;line-height:1;text-transform:uppercase;color:var(--ink);text-decoration:none}.brand b{color:var(--green);font-weight:400}
    .brand small{display:block;font:12px/1.3 Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin-top:3px}
    nav.tabs{display:flex;justify-content:space-between;gap:10px;max-width:760px;margin:16px auto 0;padding:0 20px;overflow-x:auto;border-bottom:1px solid var(--line)}
    @media (min-width:620px){nav.tabs{justify-content:flex-start;gap:26px}}
    nav.tabs a{flex:none;white-space:nowrap;padding:10px 0 12px;font-size:13.5px;font-weight:600;color:var(--mute);text-decoration:none;border-bottom:2px solid transparent;margin-bottom:-1px}
    nav.tabs a[aria-current="page"]{color:var(--ink);border-color:var(--acc)}
    main{padding:26px 0 40px}
    .eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:700;color:var(--acc);margin:0 0 10px}
    h1{font-family:var(--disp);font-weight:400;font-size:clamp(46px,11vw,72px);line-height:.95;margin:0 0 18px;letter-spacing:.01em;text-wrap:balance}
    h2{font-family:var(--disp);font-weight:400;font-size:38px;line-height:.95;margin:0 0 12px;letter-spacing:.01em;color:var(--acc)}
    p{margin:0 0 12px;color:var(--soft);text-wrap:pretty}
    section.b{padding:26px 0;border-top:1px solid var(--line)}
    .btn{display:inline-block;background:var(--acc);color:#15190f;font:700 16px Inter,sans-serif;padding:15px 24px;border-radius:8px;text-decoration:none;border:0;cursor:pointer}
    .btn.ghost{background:transparent;color:var(--soft);border:1px solid var(--line)}
    .more{font-size:15px;color:var(--mute)}.more a{color:var(--acc)}
    .card{background:var(--bg2);border:1px solid #2c3a33;border-radius:12px;padding:20px 22px}
    label.k{display:block;font:700 12px/1 Inter,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:var(--acc);margin:0 0 12px}
    input[type=text],input[type=email]{width:100%;background:#0f1411;color:var(--ink);border:1px solid #3a4a41;border-radius:8px;padding:14px 14px;font:17px Inter,sans-serif}
    input:focus{outline:2px solid var(--acc);outline-offset:1px;border-color:transparent}
    .note{border-left:3px solid var(--green);padding:2px 0 2px 14px;color:var(--soft)}
    footer{border-top:1px solid var(--line);padding:24px 20px 36px;text-align:center;font-size:13px;color:var(--mute)}
  </style>
</head>
<body>
  <header class="top">
    <a class="brand" href={member ? '/today' : '/signin'}>Vault <b>Human</b><small>Members</small></a>
  </header>
  {member && (
    <nav class="tabs" aria-label="Members">
      {tabs.map(([id, href, label]) => <a href={href} aria-current={nav === id ? 'page' : undefined}>{label}</a>)}
    </nav>
  )}
  <main><div class="wrap"><slot /></div></main>
  <footer><a href="https://www.vaulthuman.com/">www.vaulthuman.com</a> · <a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a> · Coaching, not therapy. <a href="https://www.vaulthuman.com/privacy/">Privacy</a>.</footer>
</body>
</html>
