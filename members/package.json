{
  "name": "vault-human-members",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "test": "vitest run",
    "check": "astro check",
    "db:migrate:local": "wrangler d1 migrations apply vault-human-members --local",
    "db:seed:local": "wrangler d1 execute vault-human-members --local --file=scripts/seed.sql",
    "files:seed:local": "node scripts/seed-files.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply vault-human-members --remote",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.154.0"
  }
}
