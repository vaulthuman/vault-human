// Cloudflare Workers config for members.vaulthuman.com.
// database_id is a placeholder until Russ creates the D1 database (see README.md).
{
  "name": "vault-human-members",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://members.vaulthuman.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault-human-members",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
