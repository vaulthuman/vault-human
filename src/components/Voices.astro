---
// Rotating "What people say" carousel. Same five quotes as /start (real, names withheld at their request).
// Cards swivel in 3D: the centre card faces you, its neighbours turn away at the sides.
const { id = 'voices', eyebrow = 'What people say', title = 'In their words.' } = Astro.props;
const quotes = [
  { t: "He sees things in people they often can't see in themselves, and asks the questions no one else is willing to ask, with enough warmth that you actually want to answer.", c: 'Coaching client · CEO', bg: '#1A2420' },
  { t: "He draws people in, challenges how they think, and makes space for things that don't ordinarily get said. You leave thinking differently about yourself.", c: 'Workshop participant', bg: '#2A2616' },
  { t: "He can walk straight into the most uncomfortable conversation in the room without making anyone feel attacked, and leave everyone's dignity intact.", c: 'Board chair', bg: '#2B211B' },
  { t: "I've seen him in situations where almost anyone else would have lost their composure. There's a steadiness to him that changes the room.", c: 'Executive colleague', bg: '#1E2A2A' },
  { t: "I've never once questioned whether he had my back. Sometimes he was the one most willing to tell me what I didn't want to hear.", c: 'Former colleague', bg: '#2A2420' },
];
---
<section class="sec vq" id={id}><div class="wrap">
  <div class="sec-head"><p class="eyebrow">{eyebrow}</p><h2>{title}</h2></div>
  <div class="vq-stage" role="region" aria-roledescription="carousel" aria-label="What people say about Russ" tabindex="0">
    {quotes.map((q, i) => (
      <figure class="vq-card" data-i={i} style={`background:${q.bg}`} aria-roledescription="slide" aria-label={`${i + 1} of ${quotes.length}`}>
        <span class="vq-mark" aria-hidden="true">&ldquo;</span>
        <blockquote>{q.t}</blockquote>
        <figcaption>{q.c}</figcaption>
      </figure>
    ))}
  </div>
  <div class="vq-nav">
    <button class="vq-arrow" type="button" data-dir="-1" aria-label="Previous">&#8249;</button>
    <div class="vq-dots">{quotes.map((_, i) => <button type="button" data-go={i} aria-label={`Show quote ${i + 1}`}></button>)}</div>
    <button class="vq-arrow" type="button" data-dir="1" aria-label="Next">&#8250;</button>
  </div>
  <p class="vq-fine">Names withheld at their request. Shared with permission.</p>
</div></section>

<style is:inline>
.vq{overflow-x:clip}
.vq .sec-head{text-align:center}
.vq-stage{display:grid;perspective:1400px;max-width:980px;margin:28px auto 0;outline:none;touch-action:pan-y}
.vq-card{grid-area:1/1;justify-self:center;align-self:center;width:min(620px,86%);margin:0;padding:34px 34px 28px;border-radius:14px;border:1px solid rgba(241,237,228,.14);box-shadow:0 24px 60px rgba(0,0,0,.35);
  transition:transform .9s cubic-bezier(.2,.7,.2,1),opacity .9s ease,filter .9s ease;opacity:0;transform:translateX(0) scale(.7);pointer-events:none;position:relative;backface-visibility:hidden}
.vq-card.is-active{opacity:1;transform:translateX(0) rotateY(0) scale(1);z-index:3;pointer-events:auto}
.vq-card.is-next{opacity:.42;transform:translateX(46%) rotateY(-32deg) scale(.8);z-index:2;pointer-events:auto;cursor:pointer;filter:saturate(.7)}
.vq-card.is-prev{opacity:.42;transform:translateX(-46%) rotateY(32deg) scale(.8);z-index:2;pointer-events:auto;cursor:pointer;filter:saturate(.7)}
.vq-mark{position:absolute;top:6px;left:22px;font:400 72px/1 Georgia,serif;color:#C9A24A;opacity:.55}
.vq-card blockquote{margin:14px 0 16px;font:400 clamp(19px,2.1vw,23px)/1.5 Inter,system-ui,sans-serif;color:#F1EDE4;text-wrap:pretty}
.vq-card figcaption{font:700 12px/1.3 Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#C9A24A}
.vq-nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:24px}
.vq-arrow{width:40px;height:40px;border-radius:50%;border:1px solid rgba(241,237,228,.25);background:transparent;color:#F1EDE4;font-size:24px;line-height:1;cursor:pointer}
.vq-arrow:hover{border-color:#C9A24A;color:#C9A24A}
.vq-dots{display:flex;gap:9px}
.vq-dots button{width:9px;height:9px;border-radius:50%;border:0;padding:0;background:rgba(241,237,228,.3);cursor:pointer;transition:background .3s,transform .3s}
.vq-dots button.on{background:#C9A24A;transform:scale(1.3)}
.vq-fine{text-align:center;font-size:13px;color:rgba(241,237,228,.6);margin:14px 0 0}
@media (max-width:700px){
  .vq-card{width:88%;padding:30px 24px 24px}
  .vq-card.is-next{transform:translateX(30%) rotateY(-35deg) scale(.78);opacity:.18}
  .vq-card.is-prev{transform:translateX(-30%) rotateY(35deg) scale(.78);opacity:.18}
}
@media (prefers-reduced-motion:reduce){.vq-card{transition:opacity .3s ease}}
</style>
<script is:inline>
(function(){
  document.querySelectorAll('.vq').forEach(function(root){
    var cards=[].slice.call(root.querySelectorAll('.vq-card')),dots=[].slice.call(root.querySelectorAll('.vq-dots button')),n=cards.length,cur=0,timer=null,paused=false;
    var still=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
    function show(i){cur=(i+n)%n;cards.forEach(function(c,k){c.classList.remove('is-active','is-next','is-prev');c.setAttribute('aria-hidden',k===cur?'false':'true');
      if(k===cur)c.classList.add('is-active');else if(k===(cur+1)%n)c.classList.add('is-next');else if(k===(cur-1+n)%n)c.classList.add('is-prev');});
      dots.forEach(function(d,k){d.classList.toggle('on',k===cur)});}
    function go(d){show(cur+d);restart();}
    function restart(){clearInterval(timer);if(still)return;timer=setInterval(function(){if(!paused&&!document.hidden)show(cur+1)},6500);}
    root.querySelectorAll('.vq-arrow').forEach(function(b){b.addEventListener('click',function(){go(+b.getAttribute('data-dir'))})});
    dots.forEach(function(d){d.addEventListener('click',function(){show(+d.getAttribute('data-go'));restart();})});
    cards.forEach(function(c){c.addEventListener('click',function(){if(c.classList.contains('is-next'))go(1);else if(c.classList.contains('is-prev'))go(-1);})});
    var st=root.querySelector('.vq-stage');
    st.addEventListener('mouseenter',function(){paused=true});st.addEventListener('mouseleave',function(){paused=false});
    st.addEventListener('keydown',function(e){if(e.key==='ArrowRight')go(1);if(e.key==='ArrowLeft')go(-1);});
    var x0=null;st.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;paused=true},{passive:true});
    st.addEventListener('touchend',function(e){if(x0===null)return;var dx=e.changedTouches[0].clientX-x0;x0=null;paused=false;if(Math.abs(dx)>40)go(dx<0?1:-1);});
    show(0);
    if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){restart();}else clearInterval(timer);})},{threshold:.3});io.observe(root);}else restart();
  });
})();
</script>
