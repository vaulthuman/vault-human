---
import '../styles/global.css';
const { title = "Vault Human — Law · Life · Legacy", description = "Vault Human — law, life, and legacy held as one connected whole.", beginHref = "/#begin" , image = "https://www.vaulthuman.com/og-vaulthuman.png"} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://www.vaulthuman.com").href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Vault Human" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};var gtag=window.gtag;
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD',{linker:{domains:['vaulthuman.com','tercetlaw.com','fretworksystems.com','triplicityadvisory.com','csh-vault.com']}});
    (function(){var fired=false;function fire(){if(fired)return;fired=true;gtag('event','conversion',{send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE'});gtag('event','generate_lead');}
    window.addEventListener('message',function(e){var d=e&&e.data;if(!d)return;if(typeof d==='string'){try{d=JSON.parse(d);}catch(_){return;}}if(!d||typeof d!=='object')return;var t=d.type||d.messageType||'',n=d.eventName||d.event||'';if(t==='hsFormCallback'&&(n==='onFormSubmitted'||n==='onFormSubmit'))fire();else if(n==='onFormSubmitted')fire();else if(d.accepted===true&&d.formGuid)fire();});
    window.addEventListener('hsFormCallback',function(e){if(e&&e.detail&&e.detail.eventName==='onFormSubmitted')fire();});})();
  </script>
<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"Organization","@id":"https://www.vaulthuman.com/#org","name":"Vault Human","url":"https://www.vaulthuman.com","telephone":"+1-888-833-2510","logo":"https://www.vaulthuman.com/og-vaulthuman.png","image":"https://www.vaulthuman.com/og-vaulthuman.png","description":"Vault Human is a family of professional practices - estate law, AI & systems, leadership coaching, and development advisory - built on one idea: your life is not fragmented, so your advisors should not be either.","founder":{"@type":"Person","@id":"https://www.vaulthuman.com/#russ","name":"Russ Michaels","alternateName":"Russ Michael Schmidtberger","jobTitle":"Founder","telephone":"+1-888-833-2510","worksFor":{"@id":"https://www.vaulthuman.com/#org"}},"subOrganization":[{"@type":"LegalService","name":"Tercet Law","url":"https://www.tercetlaw.com"},{"@type":"ProfessionalService","name":"Fretwork Systems","url":"https://www.fretworksystems.com"},{"@type":"ProfessionalService","name":"Triplicity","url":"https://triplicityadvisory.com"},{"@type":"ProfessionalService","name":"CSH Vault Consulting","url":"https://www.csh-vault.com"}]}</script>
<script type="application/ld+json" is:inline>{"@type":"Person","@id":"https://www.vaulthuman.com/#russ","name":"Russ Michaels","alternateName":"Russ Michael Schmidtberger","jobTitle":"Founder","telephone":"+1-888-833-2510","worksFor":{"@id":"https://www.vaulthuman.com/#org"}}</script>
</head>
<body>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href="/">Vault Human</a>
      <nav class="navlinks">
        <a href="/writing">Writing</a>
        <a href="/speaking">Speaking</a>
        <a class="navbtn" href="#" data-open-form>Begin</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site">
    <div class="wrap">
      <p class="sig">VAULT HUMAN</p>
      <p class="meta">An integrated practice across law, life &amp; legacy &middot; <a href="tel:+18888332510">(888)&nbsp;833-2510</a> &middot; &copy; {year}</p>
    </div>
  </footer>

  <!-- Start-a-conversation modal -->
  <div id="vh-modal" class="vh-modal" aria-hidden="true">
    <div class="vh-modal__bg" data-close-form></div>
    <div class="vh-modal__card" role="dialog" aria-modal="true" aria-label="Begin a conversation">
      <button class="vh-modal__x" type="button" data-close-form aria-label="Close">&times;</button>
      <h2 class="vh-modal__title">Begin a conversation</h2>
      <p class="vh-modal__sub">Share a few details and we&rsquo;ll be in touch &mdash; one relationship, one memory.</p>
      <div class="hs-form-frame" data-region="na2" data-form-id="3f225ab5-5a70-46d9-a497-29e6256b1e52" data-portal-id="246947446"></div>
    </div>
  </div>
  <script is:inline src="https://js-na2.hsforms.net/forms/embed/246947446.js" defer></script>
  <script is:inline>
  (function(){var m=document.getElementById('vh-modal');if(!m)return;
  function o(e){if(e)e.preventDefault();m.classList.add('is-open');m.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}
  function c(){m.classList.remove('is-open');m.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}
  document.addEventListener('click',function(e){var t=e.target.closest('[data-open-form]');if(t){o(e);return;}if(e.target.closest('[data-close-form]'))c();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')c();});})();
  </script>
<script>
addEventListener('DOMContentLoaded',function(){
 if(!('IntersectionObserver'in window))return;
 var s='main .wrap>section:not(.hero),main .wrap>h2,main .wrap>.prose,main .wrap>.lede,main .wrap>.cta,main .wrap>.ctarow,main .wrap>.turn,main .wrap>.closing,main .wrap>.why,main .wrap>.tags,main .wrap>.markets,main .wrap>.pkgs,main .wrap>.areas,main .wrap>.steps,main .wrap>.cols,main .wrap>.pagehead';
 var e=[].slice.call(document.querySelectorAll(s));
 e.forEach(function(x){x.classList.add('reveal')});
 var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('in');o.unobserve(y.target)}})},{threshold:0.06,rootMargin:'0px 0px -30px 0px'});
 e.forEach(function(x){o.observe(x)});
});
</script>

</body>
</html>
