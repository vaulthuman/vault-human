---
import '../styles/home.css';
import '../styles/nature.css';
const { title = "Vault Human — Daily coaching for the whole of you", description = "Vault Human is daily coaching: one short lesson every morning, one small practice, and a coach who walks the year with you. From $99 a month.", beginHref = "/#begin" , image = "https://www.vaulthuman.com/og-vaulthuman.png"} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://www.vaulthuman.com").href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Vault Human" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};var gtag=window.gtag;
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD',{linker:{domains:['vaulthuman.com','tercetlaw.com','fretworksystems.com','triplicityadvisory.com','csh-vault.com']}});
  </script>
<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"Organization","@id":"https://www.vaulthuman.com/#org","name":"Vault Human","url":"https://www.vaulthuman.com","telephone":"+1-888-833-2510","logo":"https://www.vaulthuman.com/og-vaulthuman.png","image":"https://www.vaulthuman.com/og-vaulthuman.png","description":"Vault Human is daily coaching for the whole of you. Three companies stand behind it: Fretwork Systems, Triplicity Advisory and Tercet Law.","founder":{"@type":"Person","@id":"https://www.vaulthuman.com/#russ","name":"Russ Michaels","alternateName":"Russ Michael Schmidtberger","jobTitle":"Founder","telephone":"+1-888-833-2510","worksFor":{"@id":"https://www.vaulthuman.com/#org"}},"sameAs":["https://www.linkedin.com/in/russ-michaels/"],"subOrganization":[{"@type":"LegalService","name":"Tercet Law","url":"https://www.tercetlaw.com"},{"@type":"ProfessionalService","name":"Fretwork Systems","url":"https://www.fretworksystems.com"},{"@type":"ProfessionalService","name":"Triplicity","url":"https://triplicityadvisory.com"}]}</script>
<script type="application/ld+json" is:inline>{"@type":"Person","@id":"https://www.vaulthuman.com/#russ","name":"Russ Michaels","alternateName":"Russ Michael Schmidtberger","jobTitle":"Founder","telephone":"+1-888-833-2510","worksFor":{"@id":"https://www.vaulthuman.com/#org"}}</script>
  <style is:inline>:root{--pagebg:url("https://images.unsplash.com/photo-1474044159687-1ee9f3a51722?w=1800&q=55&auto=format&fit=crop")}</style>
</head>
<body>
  <header class="site"><div class="wrap bar">
    <a class="brand" href="/">Vault <b>Human</b></a>
    <nav class="navlinks" id="navlinks"><a href="/method/">The approach</a><div class="navdrop"><button class="navdrop__btn" type="button" aria-expanded="false" aria-haspopup="true">Your life <span aria-hidden="true">▾</span></button><div class="navdrop__menu"><a href="/as-learned/">Learning your past</a><a href="/as-loved/">Loving your present</a><a href="/as-lived/">Living your future</a></div></div><a href="/writing/">Writing</a><a href="/speaking/">About Russ</a><a class="btn btn-acc" href="#" data-open-form>Begin</a></nav><button class="navtoggle" type="button" aria-label="Open menu" aria-controls="navlinks" aria-expanded="false"><span></span><span></span><span></span></button>
  </div></header>

  <main>
    <slot />
  </main>

  <footer class="site"><div class="wrap foot">
    <div><a class="brand" href="/">Vault <b>Human</b></a><p>Daily coaching with Russ Michaels.</p><p><a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a> · <a href="tel:+18888332510">(888) 833-2510</a></p></div>
    <ul><li><a href="/as-learned/">As Learned · the past</a></li><li><a href="/as-loved/">As Loved · the present</a></li><li><a href="/as-lived/">As Lived · the future</a></li><li><a href="/plans/">Plans and pricing</a></li><li><a href="/writing">Writing</a></li><li><a href="/speaking">Speaking</a></li></ul>
    <ul><li><a href="https://www.fretworksystems.com">Fretwork Systems</a> · automation</li><li><a href="https://triplicityadvisory.com">Triplicity Advisory</a> · leadership coaching</li><li><a href="https://www.tercetlaw.com">Tercet Law</a> · wills and trusts</li></ul>
  </div><div class="wrap legal"><span>&copy; {year} Vault Human, LLC. Coaching is not legal, medical, financial or therapeutic advice.</span><span>Learn · Love · Live · Listen</span></div></footer>

  <!-- Start-a-conversation modal -->
  <div id="vh-modal" class="vh-modal" aria-hidden="true">
    <div class="vh-modal__bg" data-close-form></div>
    <div class="vh-modal__card" role="dialog" aria-modal="true" aria-label="Your first key is waiting">
      <button class="vh-modal__x" type="button" data-close-form aria-label="Close">&times;</button>
      <h2 class="vh-modal__title">Your first key is waiting</h2><p class="vh-modal__sub">One short teaching and one small practice, in your inbox within minutes. Tell us a little about you, and Russ will write back.</p>
      <div class="hs-form-frame" data-region="na2" data-form-id="3f225ab5-5a70-46d9-a497-29e6256b1e52" data-portal-id="246947446"></div><p class="vh-modal__fine">Free. One short email each morning. Unsubscribe anytime.</p>
    </div>
  </div>
  <script is:inline src="https://js-na2.hsforms.net/forms/embed/246947446.js" defer></script>
  <script is:inline>
  (function(){var m=document.getElementById('vh-modal');if(!m)return;
  function o(e){if(e)e.preventDefault();m.classList.add('is-open');m.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}
  function c(){m.classList.remove('is-open');m.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}
  document.addEventListener('click',function(e){var t=e.target.closest('[data-open-form]');if(t){o(e);return;}if(e.target.closest('[data-close-form]'))c();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')c();});})();
  </script>
<script>
addEventListener('DOMContentLoaded',function(){
 if(!('IntersectionObserver'in window))return;
 var s='main .wrap>section:not(.hero),main .wrap>h2,main .wrap>.prose,main .wrap>.lede,main .wrap>.cta,main .wrap>.ctarow,main .wrap>.turn,main .wrap>.closing,main .wrap>.why,main .wrap>.tags,main .wrap>.markets,main .wrap>.pkgs,main .wrap>.areas,main .wrap>.steps,main .wrap>.cols,main .wrap>.pagehead';
 var e=[].slice.call(document.querySelectorAll(s));
 var vh=window.innerHeight||800;
 var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('in');o.unobserve(y.target)}})},{threshold:0.06,rootMargin:'0px 0px -30px 0px'});
 e.forEach(function(x){if(x.getBoundingClientRect().top<vh*0.9)return;x.classList.add('reveal');o.observe(x)});
 setTimeout(function(){e.forEach(function(x){x.classList.add('in')})},1500);
});
</script>

<script is:inline>(function(){var b=document.querySelector(".navtoggle"),n=document.getElementById("navlinks");if(!b||!n)return;function set(o){document.body.classList.toggle("nav-open",o);b.setAttribute("aria-expanded",o?"true":"false");b.setAttribute("aria-label",o?"Close menu":"Open menu");}b.addEventListener("click",function(){set(!document.body.classList.contains("nav-open"));});n.addEventListener("click",function(e){if(e.target.closest("a"))set(false);});document.addEventListener("keydown",function(e){if(e.key==="Escape")set(false);});})();</script>
<script is:inline>(function(){var h=document.querySelector("header.site");function f(){if(h)h.classList.toggle("scrolled",scrollY>40)}addEventListener("scroll",f,{passive:true});f();document.querySelectorAll(".navdrop__btn").forEach(function(b){b.addEventListener("click",function(e){e.stopPropagation();document.querySelectorAll(".navdrop.open").forEach(function(x){if(x!==b.parentNode)x.classList.remove("open")});var d=b.parentNode,o=!d.classList.contains("open");d.classList.toggle("open",o);b.setAttribute("aria-expanded",o?"true":"false")})});document.addEventListener("click",function(e){document.querySelectorAll(".navdrop.open").forEach(function(d){if(!d.contains(e.target)){d.classList.remove("open");d.querySelector(".navdrop__btn").setAttribute("aria-expanded","false")}})});})();</script>
</body>
</html>
