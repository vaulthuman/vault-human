---
import '../styles/global.css';
const { title = "Vault Human — Law · Life · Legacy", description = "Vault Human — law, life, and legacy held as one connected whole." } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href="/">Vault Human</a>
      <nav class="navlinks">
        <a href="/writing">Writing</a>
        <a href="/speaking">Speaking</a>
        <a class="navbtn" href="/#begin">Begin</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site">
    <div class="wrap">
      <p class="sig">VAULT HUMAN</p>
      <p class="meta">An integrated practice across law, life &amp; legacy &middot; <a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a> &middot; &copy; {year}</p>
    </div>
  </footer>
</body>
</html>
