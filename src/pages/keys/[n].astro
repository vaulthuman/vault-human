.kx-nav a{color:#8FA67E;text-decoration:none}
@media(max-width:600px){.kx-letter h1,.kx-letter h2.kx-t{font-size:32px}.kx-letter p{font-size:19px}.kx-grid{grid-template-columns:repeat(auto-fill,minmax(38px,1fr))}}
</style>
