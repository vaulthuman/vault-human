---
import '../../styles/home.css';
import '../../styles/nature.css';
import { letters } from '../../data/keys.js';
export function getStaticPaths(){ const days=[...new Set(letters.map(l=>l.day))]; return days.map(d=>({params:{n:String(d)}})); }
const { n } = Astro.params; const day = Number(n);
const mind = letters.find(l=>l.vault==='mind' && l.day===day);
const body = letters.find(l=>l.vault==='body' && l.day===day);
const lead = mind || body;
const year = new Date().getFullYear();
const title = `Day ${day} · ${lead.title} — The Vault Keys`;
const canonical = `https://www.vaulthuman.com/keys/${day}/`;
const desc = lead.paras[0].slice(0,155);
const days=[...new Set(letters.map(l=>l.day))].sort((a,b)=>a-b);
const i=days.indexOf(day); const prev=i>0?days[i-1]:null; const next=i<days.length-1?days[i+1]:null;
function fmt(d){ return new Date(d+'T12:00:00').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}); }
function html(p){ return p.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/\*(.+?)\*/g,'<em>$1</em>'); }
---
