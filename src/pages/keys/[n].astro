---
import { letters } from '../../data/letters.js';
export function getStaticPaths(){ const days=[...new Set(letters.map(l=>l.day))]; return days.map(d=>({params:{n:String(d)},props:{to:(letters.find(l=>l.day===d&&l.vault==='mind')||letters.find(l=>l.day===d)).slug}})); }
const { to } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Vault Human — Writing</title><meta http-equiv="refresh" content={`0; url=/writing/${to}/`}><link rel="canonical" href={`https://www.vaulthuman.com/writing/${to}/`}><meta name="robots" content="noindex"></head><body><p><a href={`/writing/${to}/`}>This letter has moved.</a></p></body></html>
