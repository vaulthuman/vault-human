.kx-letter .eyebrow{margin-bottom:6px}
.kx-letter h1,.kx-letter h2.kx-t{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:40px;line-height:1.1;margin:0 0 22px}
.kx-letter p{font-family:'Cormorant Garamond',Georgia,serif;font-size:21px;line-height:1.55;margin:0 0 18px}
