.kx-grid a,.kx-grid span{display:flex;align-items:center;justify-content:center;aspect-ratio:1;border:1px solid rgba(255,255,255,.18);border-radius:8px;font-family:Inter,sans-serif;font-size:13px;text-decoration:none;color:#fff}
