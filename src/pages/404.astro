---
// Shown (with a real 404 status) for any address that no longer exists — e.g. old Wix links.
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Vault Human" description="That page has moved. Start here.">
  <div class="wrap" style="text-align:center;max-width:760px;margin:0 auto;padding:90px 20px 110px">
    <p class="eyebrow" style="letter-spacing:2px;text-transform:uppercase;opacity:.6;font-size:14px">Page not found</p>
    <h1 style="font-size:44px;margin:10px 0 14px">That page has moved.</h1>
    <p style="font-size:18px;line-height:1.6;opacity:.85;margin:0 0 28px">Vault Human has a new home. Everything is a click away from here.</p>
    <a class="btn btn-acc" href="/">Go to Vault Human</a>
  </div>
</Base>
