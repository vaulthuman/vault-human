---
// /book — the one page where anyone, from anywhere on the site, books the free 30-minute call with Russ.
// No form first: Calendly collects name, email and phone at booking. Phone and email sit beside it for the people who'd rather talk now.
import Base from '../layouts/Base.astro';
---
<Base title="A free 30-minute call with Russ — Vault Human" description="Pick a time for a free 30-minute call with Russ Michaels. No cost, no obligation.">
  <div class="wrap" style="text-align:center;max-width:760px;margin:0 auto;padding:70px 20px 24px">
    <p class="eyebrow" style="letter-spacing:2px;text-transform:uppercase;opacity:.6;font-size:14px">Free · 30 minutes · no obligation</p>
    <h1 style="font-size:40px;margin:10px 0 14px">Talk with Russ. Then decide.</h1>
    <p style="font-size:18px;line-height:1.6;opacity:.85">Pick a time below. You'll get a calendar invite with the video link. No cost, no obligation, and if Vault Human isn't the right fit, Russ will tell you.</p>
  </div>
  <div class="wrap" style="max-width:1000px;margin:0 auto;padding:0 12px 80px">
    <div class="calendly-inline-widget" data-url="https://calendly.com/vaulthuman/free-call?hide_gdpr_banner=1&hide_landing_page_details=1" style="min-width:320px;height:760px;border-radius:12px;overflow:hidden;background:#F4F1EA"></div>
    <p style="text-align:center;margin-top:18px;font-size:15px;opacity:.75">Calendar not loading? <a href="https://calendly.com/vaulthuman/free-call" target="_blank" rel="noopener">Open it here</a>.</p>
  </div>
  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
</Base>
