<body data-time="all">
  <header class="site"><div class="wrap bar"><a class="brand" href="/">Vault <b>Human</b></a><nav class="navlinks" id="navlinks"><a href="/method/">The approach</a><div class="navdrop"><button class="navdrop__btn" type="button" aria-expanded="false" aria-haspopup="true">Your life <span aria-hidden="true">▾</span></button><div class="navdrop__menu"><a href="/as-learned/">Learning your past</a><a href="/as-loved/">Loving your present</a><a href="/as-lived/">Living your future</a></div></div><a href="/writing/">Writing</a><a href="/speaking/">About</a><a href="/plans/">Plans</a><a class="btn btn-acc" href="https://buy.stripe.com/fZu8wP9Jl9fO1d2dqU6Na00">Begin</a></nav><button class="navtoggle" type="button" aria-label="Open menu" aria-controls="navlinks" aria-expanded="false"><span></span><span></span><span></span></button></div></header>
  <main>
    <style is:inline>
      .in-hero{position:relative;min-height:560px;display:flex;align-items:flex-end;background:#121715 url("https://images.unsplash.com/photo-1758272959140-e727ef77bbda?w=1800&q=65&auto=format&fit=crop") 50% 40%/cover}
      .in-hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(18,23,21,.94) 0%,rgba(18,23,21,.78) 45%,rgba(18,23,21,.25) 100%),linear-gradient(180deg,rgba(18,23,21,0) 60%,#141A16 100%)}
      .in-hero .wrap{position:relative;z-index:2;padding-top:150px;padding-bottom:70px}
      .in-hero h1{font-family:"Bebas Neue",sans-serif;font-weight:400;font-size:clamp(46px,7vw,92px);line-height:.9;letter-spacing:.01em;margin:0;max-width:760px}
      .in-hero h1 em{font-style:normal;color:var(--acc-soft)}
      .in-hero .lede{max-width:560px}
      .in-four{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:34px;max-width:860px}
      .in-four a{border-top:2px solid var(--acc);padding-top:10px;text-decoration:none;color:var(--ink)}
      .in-four b{display:block;font-family:"Bebas Neue",sans-serif;font-weight:400;font-size:22px;letter-spacing:.03em}
      .in-four span{font-size:13px;color:var(--muted)}
      .in-steps{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
      .in-step{border:1px solid var(--line);border-radius:10px;padding:18px 16px;background:rgba(27,35,29,.6)}
      .in-step .n{font-family:"Bebas Neue",sans-serif;font-size:36px;color:var(--brown);line-height:1}
      .in-step h3{font-family:"Bebas Neue",sans-serif;font-weight:400;font-size:22px;letter-spacing:.03em;margin:6px 0 6px;line-height:1}
      .in-step p{font-size:14px;color:var(--muted);margin:0;line-height:1.45}
      .in-step.last{background:var(--acc);border-color:var(--acc);color:#121715}.in-step.last p{color:#1d2a1f}.in-step.last .n{color:#121715}
      .in-pages{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;align-items:start}
      .in-page{margin:0}.in-page .pg{position:relative;border-radius:3px;overflow:hidden;box-shadow:0 14px 34px rgba(0,0,0,.45)}
      .in-page img{display:block;width:100%;height:auto}
      .in-page .lock{position:absolute;left:50%;top:70%;transform:translate(-50%,-50%);background:#121715;color:var(--ink);font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;padding:8px 14px;border-radius:30px;white-space:nowrap}
      .in-page figcaption,.in-phone figcaption{margin-top:12px;font-size:14px;color:var(--muted);line-height:1.4}
      .in-page figcaption b,.in-phone figcaption b{display:block;font-family:"Bebas Neue",sans-serif;font-weight:400;font-size:21px;letter-spacing:.03em;color:var(--ink)}
      .in-phones{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;align-items:start}
      .in-phone{margin:0}.in-phone .ph{background:#0B0F0C;border-radius:30px;padding:7px;box-shadow:0 16px 36px rgba(0,0,0,.5);border:1px solid rgba(241,237,228,.12)}
      .in-phone img{display:block;width:100%;height:auto;border-radius:24px}
      .in-call{display:grid;grid-template-columns:1.7fr 1fr;gap:28px;align-items:start}
      .in-photo{position:relative;border-radius:14px;overflow:hidden;box-shadow:0 18px 40px rgba(0,0,0,.45)}
      .in-photo img{display:block;width:100%;height:100%;aspect-ratio:3/2;object-fit:cover;object-position:60% 50%}
      .in-photo .wk{position:absolute;left:16px;top:16px;width:min(240px,45%);background:rgba(245,241,232,.96);color:#1F2621;border-radius:8px;padding:12px 14px;box-shadow:0 8px 24px rgba(0,0,0,.25)}
      .in-photo .wk small{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#5E7550;font-weight:700}
      .in-photo .wk .big{font-family:"Bebas Neue",sans-serif;font-size:34px;color:#B88A5E;line-height:1;margin-top:4px}
      .in-photo .wk .bars{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;align-items:end;height:34px;margin-top:6px}
      .in-photo .wk .bars i{display:block;border-radius:2px;background:#8FA67E}
      .in-cards{display:flex;flex-direction:column;gap:12px}
      .in-card{border:1px solid var(--line);border-radius:10px;padding:18px 18px;background:rgba(27,35,29,.6)}
      .in-card h3{font-family:"Bebas Neue",sans-serif;font-weight:400;font-size:24px;letter-spacing:.03em;margin:0 0 4px;line-height:1}
      .in-card p{margin:0;font-size:15px;color:var(--muted)}
      .in-words{display:grid;grid-template-columns:.8fr 1.3fr .9fr;gap:28px;align-items:start}
      .in-month{background:#F5F1E8;color:#1F2621;border-radius:6px;padding:26px 26px;box-shadow:0 16px 36px rgba(0,0,0,.4)}
      .in-month .t{display:flex;justify-content:space-between;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#5D6559;gap:10px}
      .in-month h3{font-family:"Bebas Neue",sans-serif;font-weight:400;font-size:38px;line-height:.95;margin:14px 0 4px;color:#141A16}
      .in-month .rule{height:2px;width:46px;background:#B88A5E;margin:10px 0 16px}
      .in-month .nums{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
      .in-month .nums b{display:block;font-family:"Bebas Neue",sans-serif;font-weight:400;font-size:34px;color:#B88A5E;line-height:1}
      .in-month .nums span{font-size:12px;color:#5D6559}
      .in-month .lab{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#5E7550;font-weight:700;margin-top:4px}
      .in-month q{display:block;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:22px;line-height:1.25;color:#141A16;margin:4px 0 12px;quotes:none}
      .in-month p{margin:2px 0 12px;font-size:14px}
      .in-month .nx{background:#ECE6D8;border-radius:5px;padding:10px 12px;font-size:13px}
      .in-gate{background:#0E1310;border:1px solid rgba(241,237,228,.14);border-radius:10px;padding:30px 22px;text-align:center}
      .in-gate small{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--acc)}
      .in-gate svg{width:64px;display:block;margin:18px auto 12px}
      .in-gate b{display:block;font-family:"Bebas Neue",sans-serif;font-weight:400;font-size:32px;letter-spacing:.02em}
      .in-gate p{font-size:14px;color:var(--muted);margin:8px 0 0}
      .in-fine{font-size:12.5px;color:var(--muted);margin-top:26px;opacity:.8}
      .in-left .sec-head{text-align:left;margin-left:0}
      @media (max-width:1000px){.in-steps{grid-template-columns:repeat(3,1fr)}.in-phones{grid-template-columns:repeat(3,1fr)}.in-phones .in-phone:nth-child(n+4){display:none}.in-call,.in-words{grid-template-columns:1fr}.in-words .in-letter{max-width:300px}}
      @media (max-width:640px){.in-four{grid-template-columns:1fr 1fr}.in-steps{grid-template-columns:1fr 1fr}.in-pages{grid-template-columns:1fr 1fr}.in-phones{grid-template-columns:1fr 1fr}.in-phones .in-phone:nth-child(n+3){display:none}.in-photo .wk{display:none}.in-hero{min-height:520px}.in-words .in-letter{max-width:230px;margin:0 auto}}
    </style>

    <section class="in-hero"><div class="wrap">
      <p class="eyebrow">Look inside</p>
      <h1>See what you get. <em>Before you begin.</em></h1>
      <p class="lede">A booklet for every key, the app on your phone, a coach on the call, and words waiting for you every morning.</p>
      <div class="ctarow"><a class="btn btn-acc" href="/start/#book">Book a free call</a><a class="btn btn-line" href="#booklet">Look inside</a></div>
      <div class="in-four"><a href="#booklet"><b>The booklet</b><span>Your key, in your hands</span></a><a href="#words"><b>The words</b><span>Every morning, every month</span></a><a href="#app"><b>The app</b><span>Captures your work</span></a><a href="#call"><b>The call</b><span>A coach, face to face</span></a></div>
    </div></section>

    <section class="sec" id="month"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Your first month</p><h2>From first call to first gate.</h2></div>
      <div class="in-steps">
        <div class="in-step"><div class="n">01</div><h3>The free call</h3><p>Thirty minutes. You talk, we listen, you leave with one next step.</p></div>
        <div class="in-step"><div class="n">02</div><h3>Welcome</h3><p>Your first key arrives: the booklet, and the app on your phone.</p></div>
        <div class="in-step"><div class="n">03</div><h3>Every morning</h3><p>A short letter at 6 a.m. The letter is the key.</p></div>
        <div class="in-step"><div class="n">04</div><h3>Every day</h3><p>The practice, then capture whatever comes up, any time.</p></div>
        <div class="in-step"><div class="n">05</div><h3>Day 7</h3><p>A check-in with your coach. Bring what you wrote.</p></div>
        <div class="in-step last"><div class="n">06</div><h3>A gate opens</h3><p>When the practice is yours, the next chamber opens.</p></div>
      </div>
    </div></section>

    <section class="sec" id="booklet"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The booklet</p><h2>A key you can hold.</h2><p class="lede">Every key comes as a booklet: the teaching, the practice, three days of worksheets, and what your coach will say when it's hard. Here is one of them.</p></div>
      <div class="in-pages">
        <figure class="in-page"><div class="pg"><img src="/img/inside/booklet-cover.jpg" alt="Cover of the Who Made You booklet" width="800" height="1035" loading="lazy" /></div><figcaption><b>Who Made You</b>A key in three days</figcaption></figure>
        <figure class="in-page"><div class="pg"><img src="/img/inside/booklet-key.jpg" alt="The key in one page, from the Who Made You booklet" width="800" height="1035" loading="lazy" /></div><figcaption><b>The key in one page</b>Why it matters, in plain words</figcaption></figure>
        <figure class="in-page"><div class="pg"><img src="/img/inside/booklet-practice.jpg" alt="The three-move practice page from the Who Made You booklet" width="800" height="1035" loading="lazy" /></div><figcaption><b>The practice</b>A name, a page and your voice</figcaption></figure>
        <figure class="in-page"><div class="pg"><img src="/img/inside/booklet-day1.jpg" alt="The Day 1 page, with its worksheet softened" width="800" height="1035" loading="lazy" /><span class="lock">For members</span></div><figcaption><b>Day by day</b>Worksheets for each day of the key</figcaption></figure>
      </div>
    </div></section>

    <section class="sec dark" id="words"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The words</p><h2>Something waiting every morning.</h2><p class="lede">A letter to start each day, a page at the end of each month, and a card each time a gate opens.</p></div>
      <div class="in-words">
        <figure class="in-phone in-letter"><div class="ph"><img src="/img/inside/letter.jpg" alt="The morning letter for Who Made You on a phone" width="560" height="1212" loading="lazy" /></div><figcaption><b>The morning letter</b>A new one every day. <a href="/writing/" style="color:var(--acc-soft)">Read them</a></figcaption></figure>
        <figure class="in-phone" style="margin:0"><div class="in-month">
          <div class="t"><span>Vault Human</span><span>October · For you only</span></div>
          <h3>Your month, in your words.</h3><div class="rule"></div>
          <div class="nums"><div><b>19</b><span>days you showed up</span></div><div><b>2</b><span>letters read aloud</span></div><div><b>31</b><span>captures</span></div></div>
          <div class="lab">A line you wrote</div><q>"I read it to my old coach. He went quiet, then said he still has the team photo."</q>
          <div class="lab">Words that kept coming up</div><p>morning · my dad · thank you · enough · yes</p>
          <div class="nx">Next month: Chamber 1 continues.</div>
        </div><figcaption><b>Your month</b>One page, made from your own folder, on the 1st</figcaption></figure>
        <figure class="in-phone" style="margin:0"><div class="in-gate">
          <small>Gate one · opened</small>
          <svg viewBox="0 0 60 80" aria-hidden="true"><path d="M6 78V30a24 24 0 0 1 48 0v48" fill="none" stroke="#8FA67E" stroke-width="3"/><path d="M18 78V34a12 12 0 0 1 24 0v44" fill="rgba(143,166,126,.25)" stroke="#C9A98A" stroke-width="1.5"/></svg>
          <b>The door is yours.</b><p>The practice is yours now. Chamber 2 is open.</p>
        </div><figcaption><b>The gate card</b>When a practice becomes yours</figcaption></figure>
      </div>
      <p class="in-fine">Screens and entries shown are samples.</p>
    </div></section>

    <section class="sec" id="app"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The app</p><h2>It captures your work.</h2><p class="lede">Whatever comes up while you do a key, a thought, a voice note, a photo of the page you wrote, goes straight into your own private folder. It holds today's practice too, and shares only what you choose with your coach.</p></div>
      <div class="in-phones">
        <figure class="in-phone"><div class="ph"><img src="/img/inside/app-capture.jpg" alt="App screen: capturing a thought after writing the letter" width="560" height="1212" loading="lazy" /></div><figcaption><b>Capture</b>Type it, say it or snap it</figcaption></figure>
        <figure class="in-phone"><div class="ph"><img src="/img/inside/app-today.jpg" alt="App screen: today's key, Who Made You" width="560" height="1212" loading="lazy" /></div><figcaption><b>Today</b>Your key and its practice</figcaption></figure>
        <figure class="in-phone"><div class="ph"><img src="/img/inside/app-folder.jpg" alt="App screen: My Folder with your week" width="560" height="1212" loading="lazy" /></div><figcaption><b>My Folder</b>Your year, in your words</figcaption></figure>
        <figure class="in-phone"><div class="ph"><img src="/img/inside/app-door.jpg" alt="App screen: writing down the person who believed in you first" width="560" height="1212" loading="lazy" /></div><figcaption><b>The page</b>Your words, kept for you</figcaption></figure>
        <figure class="in-phone"><div class="ph"><img src="/img/inside/app-path.jpg" alt="App screen: your path through the chambers and gates" width="560" height="1212" loading="lazy" /></div><figcaption><b>Your path</b>Chambers and gates, at your pace</figcaption></figure>
      </div>
    </div></section>

    <section class="sec dark" id="call"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The call</p><h2>A coach, face to face.</h2><p class="lede">By video or phone, from your kitchen table. Your coach sees only what you choose to share.</p></div>
      <div class="in-call">
        <figure class="in-photo" style="margin:0">
          <img src="https://images.unsplash.com/photo-1616587894289-86480e533129?w=1400&q=72&auto=format&fit=crop" alt="A man smiling on a video call with his coach at a sunny kitchen table" width="1400" height="934" loading="lazy" />
          <div class="wk"><small>Shared with your coach</small><div class="big">5 of 7</div><div style="font-size:12px;color:#5D6559">days you showed up this week</div><div class="bars"><i style="height:40%;opacity:.45"></i><i style="height:55%;opacity:.45"></i><i style="height:30%;opacity:.45"></i><i style="height:70%"></i><i style="height:60%"></i><i style="height:85%"></i><i style="height:95%;background:#5E7550"></i></div></div>
        </figure>
        <div class="in-cards">
          <div class="in-card"><h3>The free call</h3><p>Thirty minutes before anything is paid. Where you are, where you want to be, one next step.</p></div>
          <div class="in-card"><h3>Members</h3><p>A Day 7 check-in on your first key, and a live coaching call every month.</p></div>
          <div class="in-card"><h3>One on one</h3><p>Three private 60-minute sessions a month, with messages in between.</p></div>
        </div>
      </div>
    </div></section>

    <section class="sec final"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">Ready when you are</p><h2>Start with a free call.</h2><p class="lede">Thirty minutes. No payment. No obligation.</p></div>
      <div class="ctarow" style="justify-content:center"><a class="btn btn-acc" href="/start/#book">Book my free call</a><a class="btn btn-line" href="/plans/">See plans</a></div>
    </div></section>
</main>
  <footer class="site"><div class="wrap foot">
    <div><a class="brand" href="/">Vault <b>Human</b></a><p>Daily coaching with Russ Michaels.</p><p><a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a> · <a href="tel:+18888332510">(888) 833-2510</a></p></div>
