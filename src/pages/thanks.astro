---
// https://www.vaulthuman.com/thanks — lands after the /start form posts to HubSpot.
// Same skin as /start. Key confirmation first; the call is a quiet second option.
// The Google Ads lead conversion fires on page load.
const title = 'Your first Key is on its way — Vault Human';
const desc = 'Check your inbox. Your first Key lands in the next few minutes.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script is:inline>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD');
    gtag('event','conversion',{send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE'});
    gtag('event','generate_lead',{method:'free_week'});
  </script>
  <style is:inline>
    :root{--bg:#141A16;--bg2:#1A2420;--ink:#F1EDE4;--soft:#CFC9BC;--mute:#8E9A90;--acc:#C9A24A;--green:#8FA67E;--line:rgba(241,237,228,.14);--disp:'Bebas Neue',Inter,sans-serif}
    *{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}
    .wrap{max-width:980px;margin:0 auto;padding:0 20px}
    .top{display:flex;justify-content:space-between;align-items:baseline;padding:18px 20px 0;max-width:980px;margin:0 auto}
    .brand{font-family:var(--disp);font-weight:400;font-size:34px;letter-spacing:2px;line-height:1;text-transform:uppercase;color:var(--ink);text-decoration:none}.brand b{color:var(--green);font-weight:400}
    .brand small{display:block;font:12px/1.3 Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin-top:3px}
    .tel{font-weight:600;text-decoration:none;font-size:14px;color:var(--soft)}
    .hv{border-radius:12px;overflow:hidden;background:#000;aspect-ratio:16/9;margin:0 0 26px}
    .hv video{width:100%;height:100%;object-fit:cover;display:block}
    .hero .wrap{padding-top:28px;padding-bottom:36px}
    .lead{font-size:19px;color:var(--ink)}
    .eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:700;color:var(--acc);margin:0 0 10px}
    h1{font-family:var(--disp);font-weight:400;font-size:clamp(46px,11vw,64px);line-height:.95;margin:0 0 14px;letter-spacing:.01em}
    h2{font-family:var(--disp);font-weight:400;font-size:34px;line-height:.95;margin:0 0 10px;letter-spacing:.01em;color:var(--acc)}
    p{margin:0 0 14px;color:var(--soft);text-wrap:pretty}
    .box{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:18px 0 0}
    .box b{display:block;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--acc);margin-bottom:8px}
    .box ol{margin:0;padding-left:20px;color:var(--ink)}.box li{margin:6px 0}
    section{padding:34px 0;border-top:1px solid var(--line)}
    section .wrap p,section .wrap h2{max-width:640px}
    .btn2{display:inline-block;background:var(--acc);color:#15190f;border:0;border-radius:8px;padding:14px 20px;font-weight:700;font-size:16px;text-decoration:none;cursor:pointer;font-family:Inter,sans-serif}
    .cal{display:none;margin-top:16px}.cal.on{display:block}
    .calendly-inline-widget{min-width:300px;height:700px;border-radius:12px;overflow:hidden;background:#fff}
    .small{font-size:14px;color:var(--mute)}
    .ready a{color:var(--acc);font-weight:600}
    footer{margin-top:24px;padding:30px 20px 44px;text-align:center;font-size:13px;color:var(--mute);border-top:1px solid var(--line)}
    footer a{text-decoration:none}
    @media (min-width:900px){.hero .wrap{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;padding-top:40px}.hv{grid-column:2;grid-row:1;margin:0;aspect-ratio:16/10}.hc{grid-column:1;grid-row:1}h1{font-size:56px}}
  </style>
</head>
<body>
  <div class="top"><a class="brand" href="/">Vault <b>Human</b><small>Online life coaching</small></a><a class="tel" href="tel:+18888332510">(888) 833-2510</a></div>

  <div class="hero"><div class="wrap">
    <div class="hv"><video autoplay muted loop playsinline preload="metadata" poster="/video/thanks-table.jpg" aria-hidden="true"><source src="/video/thanks-table.mp4" type="video/mp4" /></video></div>
    <div class="hc">
    <p class="eyebrow">You're in</p>
    <h1>Your first Key is on its way.</h1>
    <p class="lead">Welcome. You just did the hardest part, which is starting.</p>
    <p>It lands in your inbox in the next few minutes, from vault@vaulthuman.com. If it isn't there, check Promotions or Spam and drag it to your inbox so tomorrow's arrives on time.</p>
    <div class="box"><b>What to do now</b>
      <ol><li>Open the email. It takes about two minutes to read.</li><li>Do the one small step at the bottom. Today, not later.</li><li>Tomorrow at 7, the next Key arrives. Your first week is free.</li></ol>
    </div>
    </div>
  </div></div>

  <section><div class="wrap">
    <h2>Want to talk it through?</h2>
    <p>If you'd rather start with a real conversation about where you are, there's a free 30-minute call with the coach. One question to answer when you book, nothing to prepare.</p>
    <button class="btn2" id="showcal" type="button">Pick a time for a free call</button>
    <div class="cal" id="cal">
      <div class="calendly-inline-widget" data-url="https://calendly.com/vaulthuman/free-call?hide_gdpr_banner=1&hide_landing_page_details=1&background_color=141a16&text_color=f1ede4&primary_color=c9a24a"></div>
      <p class="small" style="margin-top:10px">Calendar not loading? <a href="https://calendly.com/vaulthuman/free-call" target="_blank" rel="noopener">Open it here</a> or call (888) 833-2510.</p>
    </div>
    <p class="small ready" style="margin-top:22px">Ready now? <a href="https://buy.stripe.com/fZu8wP9Jl9fO1d2dqU6Na00">Start your membership</a>, $99 a month, first week free.</p>
  </div></section>

  <footer><a href="https://www.vaulthuman.com/">vaulthuman.com</a> · <a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a> · <a href="tel:+18888332510">(888) 833-2510</a><br/>© 2026 Vault Human, LLC · Coaching, not therapy. Not legal, medical, financial or therapeutic advice.</footer>

  <script is:inline>
    (function(){
      var b=document.getElementById('showcal'),c=document.getElementById('cal'),loaded=false;
      b.addEventListener('click',function(){
        c.classList.add('on');b.style.display='none';
        if(!loaded){loaded=true;var s=document.createElement('script');s.src='https://assets.calendly.com/assets/external/widget.js';s.async=true;document.body.appendChild(s);}
        try{gtag('event','call_open')}catch(e){}
        c.scrollIntoView({behavior:'smooth',block:'start'});
      });
      window.addEventListener('message',function(e){
        if(e.data&&e.data.event==='calendly.event_scheduled'){try{gtag('event','call_booked')}catch(_){}}
      });
    })();
  </script>
</body>
</html>
