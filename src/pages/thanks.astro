---
// Deploy to: vault-human/src/pages/thanks.astro  → serves at https://www.vaulthuman.com/thanks
// Set the shared HubSpot form (3f225ab5-…) to redirect here on submit.
// gtag base lives in Base.astro <head>, so the conversion fires reliably on page load
// — independent of the form embed's messaging (this is the bulletproof conversion fix).
import Base from '../layouts/Base.astro';
---
<Base title="Thank you — Vault Human" description="Your note is in. Pick a time for your free call with Russ.">
  <div class="wrap" style="text-align:center;max-width:760px;margin:0 auto;padding:70px 20px 30px">
    <p class="eyebrow" style="letter-spacing:2px;text-transform:uppercase;opacity:.6;font-size:14px">Received</p>
    <h1 style="font-size:38px;margin:10px 0 14px">Thank you. Now pick a time.</h1>
    <p style="font-size:18px;line-height:1.6;opacity:.85">Choose a 30-minute slot for your free call with Russ below. You'll get a calendar invite with the video link. If none of the times work, just reply to the welcome email in your inbox.</p>
  </div>
  <div class="wrap" style="max-width:1000px;margin:0 auto;padding:0 12px 80px">
    <div class="calendly-inline-widget" data-url="https://calendly.com/vaulthuman/free-call?hide_gdpr_banner=1&hide_landing_page_details=1" style="min-width:320px;height:760px;border-radius:12px;overflow:hidden;background:#F4F1EA"></div>
    <p style="text-align:center;margin-top:18px;font-size:15px;opacity:.75">Calendar not loading? <a href="https://calendly.com/vaulthuman/free-call" target="_blank" rel="noopener">Open it here</a> or call (888) 833-2510.</p>
  </div>
  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
  <script is:inline>
    // Order-independent: queue straight onto dataLayer. gtag.js drains the queue
    // when it loads, so this works even though Astro defers the head module that
    // defines window.gtag. (A `typeof window.gtag === "function"` guard here
    // silently no-ops, because this body script parses BEFORE that module runs.)
    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments); }
    gtag('event','conversion',{ send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE' });
    gtag('event','generate_lead');
  </script>
</Base>
