---
// Deploy to: vault-human/src/pages/thanks.astro  → serves at https://www.vaulthuman.com/thanks
// Set the shared HubSpot form (3f225ab5-…) to redirect here on submit.
// gtag base lives in Base.astro <head>, so the conversion fires reliably on page load
// — independent of the form embed's messaging (this is the bulletproof conversion fix).
import Base from '../layouts/Base.astro';
---
<Base title="Thank you — Vault Human" description="Your note is in. A real person holds it from here.">
  <div class="wrap" style="text-align:center;max-width:640px;margin:0 auto;padding:90px 20px 110px">
    <p class="eyebrow" style="letter-spacing:2px;text-transform:uppercase;opacity:.6;font-size:14px">Received</p>
    <h1 style="font-size:38px;margin:10px 0 14px">Thank you.</h1>
    <p style="font-size:18px;line-height:1.6;opacity:.85">Your note is in — and a real person is holding it from here. You'll hear back personally, usually within one business day.</p>
    <p style="margin-top:28px"><a class="btn-fill" href="/">Back to Vault Human</a></p>
  </div>
  <script is:inline>
    (function(){
      if (typeof window.gtag === 'function') {
        window.gtag('event','conversion',{send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE'});
        window.gtag('event','generate_lead');
      }
    })();
  </script>
</Base>
