 s.onerror=mp4;document.head.appendChild(s);}
b.addEventListener('click',load);
v.addEventListener('play',function(){w.classList.add('playing');});v.addEventListener('click',function(){if(v.paused){v.play()}else{v.pause()}});
v.addEventListener('ended',function(){w.classList.remove('playing');v.controls=false;v.currentTime=0;});})();</script>
