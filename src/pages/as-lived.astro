  <meta name="description" content="Life as lived: the plan you leave and the life you live on purpose. The future, coached. Part of Vault Human.">
  <meta property="og:title" content="As Lived — Vault Human · the future"><meta property="og:description" content="Life as lived: the plan you leave and the life you live on purpose. The future, coached. Part of Vault Human."><meta property="og:image" content="https://www.vaulthuman.com/og-vaulthuman.png"><meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
