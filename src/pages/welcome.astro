---
// https://www.vaulthuman.com/welcome — where Stripe sends a new member after checkout.
// Same design system as /start and /thanks. One button opens a pop-up that walks the member through:
// 1 of 2 where the Keys go (one-click confirm when /start already knows them), 2 of 2 first call (Calendly), then done.
const title = 'Welcome — Vault Human';
---
<!doctype html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content="You're in. Set up your daily Keys and book your first call." />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script is:inline>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD');
    gtag('event','trial_started',{method:'stripe'});
    (function(){var q=new URLSearchParams(location.search),id=q.get('session_id')||q.get('checkout_session_id')||'';var k='vh_trial_conv_'+(id||'noid');try{if(localStorage.getItem(k))return;localStorage.setItem(k,'1');}catch(e){}var p={send_to:'AW-18371546487/2847CLyEwN0cEPeanrhE',value:0,currency:'USD'};if(id)p.transaction_id=id;gtag('event','conversion',p);})();
  </script>
  <style is:inline>
    :root{--bg:#141A16;--bg2:#1A2420;--ink:#F1EDE4;--soft:#CFC9BC;--mute:#8E9A90;--acc:#C9A24A;--green:#8FA67E;--line:rgba(241,237,228,.14);--disp:'Bebas Neue',Inter,sans-serif}
    *{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}
    section{overflow-x:clip}
    .wrap{max-width:560px;margin:0 auto;padding:0 20px}
    .top{display:flex;justify-content:space-between;align-items:baseline;padding:18px 20px 0;max-width:980px;margin:0 auto}
    .brand{font-family:var(--disp);font-weight:400;font-size:34px;letter-spacing:2px;line-height:1;text-transform:uppercase;color:var(--ink)}.brand b{color:var(--green);font-weight:400}
    .brand small{display:block;font:12px/1.3 Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin-top:3px}
    .tel{font-weight:600;text-decoration:none;font-size:14px;color:var(--soft)}
    /* hero */
    .hero .wrap{padding-top:28px;padding-bottom:36px}
    .eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:700;color:var(--acc);margin:0 0 10px}
    h1{font-family:var(--disp);font-weight:400;font-size:clamp(46px,11vw,64px);line-height:.95;margin:0 0 14px;letter-spacing:.01em}
    .lede{font-size:17px;color:var(--soft);margin:0 0 18px}
    .lede b{color:var(--ink);font-weight:600}
    .hv{border-radius:12px;overflow:hidden;background:#000;aspect-ratio:16/9;margin:0 0 20px;position:relative}
    .hv video{width:100%;height:100%;object-fit:cover;display:block}
    /* form */
    .ask{padding:0 0 36px}
    form{display:grid;gap:10px}
    .f2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    input{width:100%;padding:14px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.05);color:var(--ink);font:16px Inter,system-ui,sans-serif}
    input::placeholder{color:#7f897f}
    input:focus{outline:2px solid var(--acc);border-color:var(--acc)}
    .btn{display:block;width:100%;background:var(--acc);color:#15190f;font-weight:700;border:0;padding:16px 22px;border-radius:8px;font-size:17px;cursor:pointer;font-family:Inter,sans-serif;margin-top:2px}
    .btn:disabled{opacity:.7}
    .under{font-size:13.5px;color:var(--mute);margin:10px 0 0;text-align:center}
    .err{color:#e0a08f;font-size:14px;margin:0;text-align:center}.err:empty{display:none}
    /* sections */
    section{padding:34px 0;border-top:1px solid var(--line);scroll-margin-top:12px}
    h2{font-family:var(--disp);font-weight:400;font-size:38px;line-height:.95;margin:0 0 10px;letter-spacing:.01em;color:var(--acc)}
    p{margin:0 0 12px;color:var(--soft)}
    .film{position:relative;border-radius:12px;overflow:hidden;background:#000;aspect-ratio:16/9;margin:14px 0 0}
    .film video{width:100%;height:100%;display:block}
    .film .play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.2);cursor:pointer;border:0}
    .film .play i{width:64px;height:64px;border-radius:50%;background:var(--acc);display:inline-block;position:relative}
    .film .play i:after{content:"";position:absolute;left:25px;top:20px;border-left:20px solid #15190f;border-top:12px solid transparent;border-bottom:12px solid transparent}
    .film.on .play{display:none}
    .coach{display:grid;grid-template-columns:150px 1fr;gap:22px;align-items:center}
    .coach img{width:150px;height:170px;object-fit:cover;object-position:60% 20%;border-radius:12px}
    .coach p{margin:0;color:var(--ink);font-size:18px;text-wrap:pretty}.coach .nm{font-family:var(--disp);font-size:32px;letter-spacing:.02em;color:var(--acc);line-height:1;margin:0 0 8px}
    .q{margin:0 0 18px;padding:20px 22px;border-radius:12px;background:#1A2420;border:1px solid var(--line);opacity:0;transform:translateX(-40px);transition:opacity .7s ease,transform .7s ease}
    .q:nth-child(even){transform:translateX(40px)}
    .q:nth-child(2){background:#2A2616}
    .q:nth-child(3){background:#2B211B}
    .q:nth-child(4){background:#1E2A2A}
    .q:nth-child(5){background:#2A2420}
    .q.in{opacity:1;transform:none}
    .q p{font-size:17px;line-height:1.55;color:var(--ink);margin:0 0 8px}
    .q cite{font-style:normal;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--acc);font-weight:700}
    .fine{font-size:13px;color:var(--mute);margin:28px 0 0}
    .why{font-size:18px;line-height:1.55;color:var(--ink);margin:0;text-wrap:pretty}
    .whybox{margin:22px 0 0}
    @media (max-width:899px){.hero .wrap{display:flex;flex-direction:column}.hc{order:1}.hv{order:2}.hero form{order:3}.whybox{order:4}}
    footer{margin-top:24px;padding:30px 20px 44px;text-align:center;font-size:13px;color:var(--mute);border-top:1px solid var(--line)}
    footer a{text-decoration:none}
    @media (min-width:900px){
      .wrap{max-width:980px}
      section .wrap{max-width:980px}
      .why{max-width:760px}
      .coach p{max-width:760px}
      .hero .wrap{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto auto;gap:14px 40px;align-items:start;padding-top:40px}
      .hc{grid-column:1;grid-row:1}
      .hero form{grid-column:1;grid-row:2}
      .hv{grid-column:2;grid-row:1;margin:0;aspect-ratio:16/10;height:auto}
      .whybox{grid-column:2;grid-row:2;margin:0;align-self:start}
      .hv video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
      h1{font-size:64px}
    }
  
    /* thanks-only */
    .hero .btn{display:block;text-align:center;padding:16px 28px;text-decoration:none;margin:6px 0 22px}
    @media (min-width:900px){.hero .btn{display:inline-block;margin-bottom:0}}
    .steps{display:grid;gap:14px}
    .steps .q{margin:0;padding:18px 20px}
    .steps .q b{display:block;font-family:var(--disp);font-weight:400;font-size:26px;letter-spacing:.02em;line-height:1;color:var(--acc);margin:0 0 6px}
    .steps .q p{margin:0;text-wrap:pretty}
    #call p{text-wrap:pretty;max-width:760px}
    #call h2{text-wrap:balance}
    .cal{margin-top:28px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#1A2420;padding:14px 0}
    .calendly-inline-widget{min-width:300px;max-width:600px;height:640px;margin:0 auto}
    .ready{font-size:14px;color:var(--mute);margin:22px 0 0}.ready a{color:var(--acc);font-weight:600}
    @media (min-width:900px){.steps{grid-template-columns:repeat(3,1fr)}
      .hero .wrap{grid-template-rows:auto;align-items:stretch}
      .hero .hc{display:flex;flex-direction:column}
      .hero .hc .btn{margin-top:auto;align-self:flex-start}
      .hero .hv{aspect-ratio:auto;min-height:280px}}
    .hero .hv{margin-bottom:0}
    .opens{font-size:18px;line-height:1.55;color:var(--ink);margin:0 0 22px;max-width:760px;text-wrap:pretty}

    /* welcome-only */
    [hidden]{display:none!important}
    h2{text-wrap:balance}
    .hero .btn{border:0}
    .steps .q{opacity:1;transform:none}
    .done-note{display:flex;gap:10px;align-items:center;color:var(--green);font-weight:600;margin:6px 0 0}
    /* pop-up */
    .ov{position:fixed;inset:0;z-index:50;background:rgba(8,11,9,.78);display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;pointer-events:none;transition:opacity .25s}
    .ov.open{opacity:1;pointer-events:auto}
    .card{position:relative;width:100%;max-width:620px;max-height:calc(100dvh - 32px);overflow:auto;background:var(--bg);border:1px solid rgba(201,162,74,.45);border-radius:16px;padding:26px 26px 24px;box-shadow:0 30px 80px rgba(0,0,0,.55);transform:translateY(16px);transition:transform .3s}
    .ov.open .card{transform:none}
    .x{position:absolute;top:10px;right:12px;background:none;border:0;color:var(--mute);font-size:28px;line-height:1;cursor:pointer;padding:6px}
    .bar{display:flex;gap:6px;margin:0 36px 18px 0}.bar i{flex:1;height:4px;border-radius:4px;background:var(--line)}.bar i.on{background:var(--acc)}
    .stepk{font:700 12px/1 Inter,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:var(--acc);margin:0 0 10px}
    .card h2{color:var(--ink);font-size:36px;margin:0 0 10px}
    .card p{color:var(--soft)}
    .known{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:6px 0 0}
    .known p{color:var(--ink);margin:0 0 14px}
    .row{display:flex;gap:10px;flex-wrap:wrap}
    .row .btn{width:auto;display:inline-block;padding:14px 22px}
    .ghost{background:none;border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:14px 22px;font:600 16px Inter,sans-serif;cursor:pointer}
    .card .msg{color:#e0a08f;font-size:14px;margin:8px 0 0}.msg:empty{display:none}
    .card .cal{margin-top:12px;padding:6px 0}
    .card .calendly-inline-widget{height:600px;max-width:100%}
    .later{font-size:14px;color:var(--mute);margin:14px 0 0;text-align:center}.later button{background:none;border:0;color:var(--acc);font:600 14px Inter,sans-serif;cursor:pointer;text-decoration:underline;padding:0}
    .tick{width:56px;height:56px;border-radius:50%;background:rgba(143,166,126,.18);display:grid;place-items:center;margin:4px 0 14px}
    .tick:after{content:"";width:18px;height:30px;border:solid var(--green);border-width:0 4px 4px 0;transform:rotate(45deg) translate(-2px,-3px)}
    @media (max-width:599px){.ov{padding:0;align-items:stretch}.card{max-height:none;height:100dvh;border-radius:0;border:0;padding:22px 18px}.card h2{font-size:32px}}
  </style>
</head>
<body>
  <div class="top"><span class="brand">Vault <b>Human</b><small>Online life coaching</small></span><a class="tel" href="tel:+18888332510">(888) 833-2510</a></div>

  <div class="hero"><div class="wrap">
    <div class="hc">
      <p class="eyebrow">Welcome, member</p>
      <h1>You're in. Welcome to Vault&nbsp;Human.</h1>
      <p class="lede" id="lede">Your receipt is on its way from Stripe. Now let's set up your daily Keys and your first call with your coach. It takes about a minute.</p>
      <button class="btn" type="button" id="go">Set up my Keys</button>
      <p class="done-note" id="donenote" hidden>✓ You're all set. Your first Key is on its way.</p>
    </div>
    <div class="hv"><video autoplay muted loop playsinline preload="metadata" poster="/video/thanks-table.jpg" aria-hidden="true"><source src="/video/thanks-table.mp4" type="video/mp4" /></video></div>
  </div></div>

  <section><div class="wrap">
    <h2>What your membership brings</h2>
    <p class="opens">A Key is a short email from your coach: two minutes to read and one small thing to do that day.</p>
    <div class="steps">
      <div class="q"><b>Every morning</b><p>A new Key in your inbox at 7 a.m.</p></div>
      <div class="q"><b>This week</b><p>Your first call with your coach.</p></div>
      <div class="q"><b>Every month</b><p>A live call with your coach.</p></div>
    </div>
    <p class="ready">Questions? Call <a href="tel:+18888332510">(888) 833-2510</a> or write <a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a>.</p>
  </div></section>

  <footer>vault@vaulthuman.com · (888) 833-2510<br/>© 2026 Vault Human, LLC · Coaching, not therapy. Not legal, medical, financial or therapeutic advice.</footer>

  <div class="ov" id="ov" aria-hidden="true">
    <div class="card" role="dialog" aria-modal="true" aria-labelledby="t1">
      <button class="x" type="button" id="x" aria-label="Close">&times;</button>
      <div class="bar" aria-hidden="true"><i id="b1" class="on"></i><i id="b2"></i></div>

      <div id="s1">
        <p class="stepk">Step 1 of 2</p>
        <h2 id="t1">Where should we send your daily Keys?</h2>
        <p>Each morning at 7 you'll get a Key: two minutes to read and one small step to take. Your first one arrives in a few minutes.</p>
        <div class="known" id="known" hidden>
          <p>We'll send them to <b id="kem"></b>.</p>
          <div class="row"><button class="btn" type="button" id="yes">That's right</button><button class="ghost" type="button" id="change">Use a different email</button></div>
        </div>
        <form id="cap" novalidate>
          <div class="f2"><input name="firstname" type="text" placeholder="First name" autocomplete="given-name" required aria-label="First name" /><input name="lastname" type="text" placeholder="Last name" autocomplete="family-name" required aria-label="Last name" /></div>
          <input name="email" type="email" placeholder="Email" autocomplete="email" inputmode="email" required aria-label="Email" />
          <input name="phone" type="tel" placeholder="Mobile (optional)" autocomplete="tel" inputmode="tel" aria-label="Mobile" />
          <button class="btn" type="submit" id="send">Next: book my first call</button>
          <p class="msg" id="msg"></p>
        </form>
      </div>

      <div id="s2" hidden>
        <p class="stepk">Step 2 of 2</p>
        <h2>Book your first call</h2>
        <p>Thirty minutes with Russ Michaels, your Vault Human coach, to talk about where you are and where you want to go. Pick any time below.</p>
        <div class="cal"><div class="calendly-inline-widget" id="calw" data-url="https://calendly.com/vaulthuman/free-call?hide_gdpr_banner=1&hide_landing_page_details=1&hide_event_type_details=1&background_color=141a16&text_color=f1ede4&primary_color=c9a24a"></div></div>
        <p class="later">Rather pick a time later? <button type="button" id="skip">Skip for now</button>. The link is in your welcome email.</p>
      </div>

      <div id="s3" hidden>
        <div class="tick" aria-hidden="true"></div>
        <h2>You're all set</h2>
        <p id="donetext">Your first Key is on its way. The next one arrives tomorrow at 7 a.m.</p>
        <button class="btn" type="button" id="close2">Done</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function(){
      document.querySelectorAll('.hv video').forEach(function(v){v.playbackRate=0.8;});
      var P=null;try{P=JSON.parse(localStorage.getItem('vh_person')||'null')}catch(_){}
      var ov=document.getElementById('ov'),f=document.getElementById('cap'),send=document.getElementById('send'),msg=document.getElementById('msg'),go=document.getElementById('go'),stage=1,calLoaded=false;
      function open(){ov.classList.add('open');ov.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}
      function close(){ov.classList.remove('open');ov.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}
      function to(n){stage=n;['s1','s2','s3'].forEach(function(id,i){document.getElementById(id).hidden=(i+1)!==n;});
        document.getElementById('b1').classList.toggle('on',n>=1);document.getElementById('b2').classList.toggle('on',n>=2);
        document.querySelector('.bar').hidden=n===3;document.querySelector('.card').scrollTop=0;}
      go.addEventListener('click',open);
      document.getElementById('x').addEventListener('click',close);
      document.getElementById('close2').addEventListener('click',close);
      document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});
      function submit(p,done){
        var hutk=(document.cookie.match(/(?:^|; )hubspotutk=([^;]+)/)||[])[1];
        var ctx={pageUri:location.origin+'/welcome/',pageName:'Vault Human — new member'};if(hutk)ctx.hutk=hutk;
        var fields=[{name:'firstname',value:p.fn},{name:'lastname',value:p.ln},{name:'email',value:p.em}];if(p.ph)fields.push({name:'phone',value:p.ph});
        return fetch('https://api-na2.hsforms.com/submissions/v3/integration/submit/246947446/3f225ab5-5a70-46d9-a497-29e6256b1e52',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({fields:fields,context:ctx})})
          .then(function(r){if(!r.ok)throw new Error(r.status);try{localStorage.setItem('vh_person',JSON.stringify(p))}catch(_){}try{gtag('event','member_details')}catch(_){}P=p;done();});
      }
      function toCall(p){
        if(!calLoaded){calLoaded=true;var c=document.getElementById('calw');c.setAttribute('data-url',c.getAttribute('data-url')+'&name='+encodeURIComponent((p.fn+' '+(p.ln||'')).trim())+'&email='+encodeURIComponent(p.em));
          var s=document.createElement('script');s.src='https://assets.calendly.com/assets/external/widget.js';s.async=true;document.body.appendChild(s);}
        to(2);go.textContent='Book my first call';
      }
      function finish(booked){
        document.getElementById('donetext').textContent=(booked?'Your call is booked and the invite is in your inbox. ':'')+'Your first Key is on its way'+(P&&P.em?' to '+P.em:'')+'. The next one arrives tomorrow at 7 a.m.';
        to(3);go.hidden=true;document.getElementById('donenote').hidden=false;
        document.getElementById('lede').textContent='Your receipt is on its way from Stripe, and your daily Keys are set up.';
      }
      if(P&&P.em){
        document.getElementById('known').hidden=false;f.hidden=true;document.getElementById('kem').textContent=P.em;
        f.firstname.value=P.fn||'';f.lastname.value=P.ln||'';f.email.value=P.em;f.phone.value=P.ph||'';
        document.getElementById('yes').addEventListener('click',function(e){e.target.disabled=true;submit(P,function(){toCall(P)}).catch(function(){e.target.disabled=false;});});
        document.getElementById('change').addEventListener('click',function(){document.getElementById('known').hidden=true;f.hidden=false;f.email.value='';f.email.focus();});
      }
      f.addEventListener('submit',function(e){
        e.preventDefault();
        var p={fn:f.firstname.value.trim(),ln:f.lastname.value.trim(),em:f.email.value.trim(),ph:f.phone.value.trim()};
        if(!p.fn||!p.ln||!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(p.em)){msg.textContent=(p.fn&&p.ln)?'Please check the email address.':'Please add your first and last name.';return;}
        send.disabled=true;send.textContent='Sending…';msg.textContent='';
        submit(p,function(){toCall(p)}).catch(function(){send.disabled=false;send.textContent='Next: book my first call';msg.textContent="That didn't go through. Try again, or call (888) 833-2510.";});
      });
      document.getElementById('skip').addEventListener('click',function(){finish(false)});
      window.addEventListener('message',function(e){if(e.data&&e.data.event==='calendly.event_scheduled'){try{gtag('event','call_booked',{who:'member'})}catch(_){}setTimeout(function(){finish(true)},2000);}});
      setTimeout(open,900);
    })();
  </script>
</body>
</html>
