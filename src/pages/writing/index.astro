---
import Base from '../../layouts/Base.astro';
import { articles } from '../../data/writing.js';
---
<Base title="Writing — Vault Human" description="Essays from Vault Human on wholeness, authorship, and what to keep in human hands.">
  <div class="wrap">
    <div class="pagehead">
      <p class="eyebrow">Writing</p>
      <h1>On being whole<br>in a world of pieces.</h1>
      <p class="dek">Essays on authorship, wholeness, and which decisions belong in human hands.</p>
    </div>

    <div class="wlist">
      {articles.map((a) => (
        <a class="witem" href={`/writing/${a.slug}`}>
          <p class="wm">{a.date}</p>
          <p class="wt">{a.title}</p>
          <p class="wd">{a.dek}</p>
        </a>
      ))}
    </div>

    <hr class="rule" />
    <p class="closing" style="font-size:24px">One lesson a day. A real person reads what you write.</p>
    <div class="ctarow"><a class="btn btn-acc" href="#" data-open-form>Start — $97/mo</a></div>
  </div>
</Base>
