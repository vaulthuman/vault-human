          <div class={`rb${it.band.n % 2 ? ' rb-r' : ''}`} style={`background-image:url('https://images.unsplash.com/${it.band.img}?w=1800&q=60&auto=format&fit=crop')`}>
            <div class="rb-in"><p class="rb-k">{it.band.k}</p><p class="rb-t">{it.band.t}</p></div>
          </div>
        ) : (
          <>
            {it.m && <div class={`rm${it.i === 0 ? ' first' : ''}`}><span>{it.m}</span></div>}
            <a class={`rl rv${it.l.day === 1 && it.l.vault === 'mind' ? ' origin' : ''}`} data-iso={it.l.iso} data-vault={it.l.vault} href={`/writing/${it.l.slug}/`}>
              <p class="rl-date">{it.l.date}</p>
              <p class="rl-t">{it.l.title}</p>
              <p class="rl-d" set:html={it.l.dek}></p>
            </a>
          </>
        ))}
        <div class="rend" aria-hidden="true"><span></span></div>
      </div>
    </section>

    <section class="sec final vid-sec" id="begin"><video class="bgvid" autoplay muted loop playsinline preload="metadata"><source src="https://assets.mixkit.co/videos/47818/47818-720.mp4" type="video/mp4"></video><div class="veil"></div><div class="wrap">
