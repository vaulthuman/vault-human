---
import '../../styles/home.css';
import '../../styles/nature.css';
import { letters, BORN } from '../../data/letters.js';
const year = new Date().getFullYear();
// Newest first: the most recent day at the top, down to the first scroll on the day Vault Human began.
const run = [...letters].sort((a, b) => b.day - a.day || (a.vault === 'mind' ? -1 : 1));
const newest = run[0];
const first = run[run.length - 1];
const days = newest.day;
// Month markers along the spine (one each time the month changes going down the page).
let lastMonth = '';
const rows = run.map((l) => { const m = l.month !== lastMonth ? l.month : null; lastMonth = l.month; return { l, m }; });
// Photo bands every ten pieces, themed to the chamber those pieces come from (none of these photos is used elsewhere on the site).
const CH = {
  1: { k: 'Getting to know myself', t: 'Know yourself first.', img: ['photo-1455390582262-044cdead277a', 'photo-1488190211105-8b0e65b80b4e'] },
  2: { k: 'Coming into my body', t: 'Change enters through the body, not the argument.', img: ['photo-1506126613408-eca07ce68773', 'photo-1433086966358-54859d0ed716'] },
  3: { k: 'Paying attention', t: 'What you attend to grows.', img: ['photo-1513836279014-a89f7a76ae86', 'photo-1465146344425-f00d5f5c8f07'] },
  4: { k: 'Finding my why', t: 'A reason you can say out loud, in your own words.', img: ['photo-1472214103451-9374bd1c798e', 'photo-1506905925346-21bda4d32df4'] },
  5: { k: 'Saying the unsaid', t: 'Name what is hidden. The unspoken runs you until it is spoken.', img: ['photo-1441974231531-c6227db76b6e', 'photo-1444927714506-8492d94b4e3d'] },
  6: { k: 'Finding my people', t: 'No one changes alone.', img: ['photo-1447752875215-b2761acb3c5d', 'photo-1501785888041-af3ef285b470'] },
  7: { k: 'Keeping a rhythm', t: 'The small thing repeated beats the big thing once.', img: ['photo-1518837695005-2083093ee35b', 'photo-1507400492013-162706c8c05e'] },
  8: { k: 'Letting go', t: 'Release before reach.', img: ['photo-1500382017468-9049fed747ef', 'photo-1501594907352-04cda38ebc29'] },
  9: { k: 'Facing tomorrow', t: 'The horizon makes the day matter.', img: ['photo-1495954484750-af469f2f9be5', 'photo-1469474968028-56623f02e42e'] },
  10: { k: 'Handing it on', t: 'Every key had a teacher. Now you are one.', img: ['photo-1502082553048-f009c37129b9', 'photo-1476514525535-07fb3b4ae5f1'] },
  11: { k: 'Sharing it', t: 'It ends in sharing.', img: ['photo-1519681393784-d120267933ba', 'photo-1490750967868-88aa4486c946'] },
};
const EVERY = 10;
let bandCount = 0;
const items = [];
rows.forEach(({ l, m }, i) => {
  if (i > 0 && i % EVERY === 0) { const c = CH[l.chamber] || CH[1]; items.push({ band: { ...c, img: c.img[bandCount % c.img.length], n: bandCount } }); bandCount++; }
  items.push({ l, m, i });
});
const desc = 'One short piece a day from Vault Human, in the order they came, from the day we began.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Writing — Vault Human</title><link rel="canonical" href="https://www.vaulthuman.com/writing/">
