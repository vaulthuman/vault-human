        <div class="ctarow"><a class="btn btn-acc" id="todays-letter" href={`/writing/${newest.slug}/`}>Today's key</a><a class="btn btn-line" href={`/writing/${first.slug}/`}>The first key</a><button class="btn btn-line" type="button" data-vpop="/img/russ/v2/how-it-works.mp4" data-vpop-poster="/img/russ/v2/how-it-works-poster.jpg">How it works</button></div>
      </div></div>
