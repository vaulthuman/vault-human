(function(){var e=[].slice.call(document.querySelectorAll('.rl.rv'));if(!('IntersectionObserver'in window)){e.forEach(function(x){x.classList.add('on')});return;}var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('on');o.unobserve(y.target)}})},{threshold:0.1,rootMargin:'0px 0px -40px 0px'});e.forEach(function(x){o.observe(x)});})();</script>
