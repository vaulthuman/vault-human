---
import Base from '../../layouts/Base.astro';
import fs from 'node:fs';
import { articles } from '../../data/writing.js';
import { letters } from '../../data/letters.js';
import { letterVideos } from '../../data/letter-videos.js';
export function getStaticPaths() {
  const ess = articles.map((a) => ({ params: { slug: a.slug }, props: { a, kind: 'essay' } }));
  const let_ = letters.map((l, i) => ({ params: { slug: l.slug }, props: { a: l, kind: 'letter', prev: i > 0 ? letters[i-1] : null, next: i < letters.length-1 ? letters[i+1] : null } }));
  return [...ess, ...let_];
}
const { a, kind, prev, next } = Astro.props;
const WITH_PDF = ['the-fracture', 'the-warmer-intelligence', 'the-mirror', 'decision-points', 'how-do-we-grow-leaders-now'];
const pdf = kind === 'essay' && WITH_PDF.includes(a.slug) ? `/${a.slug}.pdf` : null;
const plainDek = (a.dek || '').replace(/<[^>]+>/g, '');
const vid = kind === 'letter' ? letterVideos[a.slug] : null;
const ogImage = fs.existsSync(`${process.cwd()}/public/og/w/${a.slug}.jpg`) ? `https://www.vaulthuman.com/og/w/${a.slug}.jpg` : 'https://www.vaulthuman.com/og/vh.jpg';
---
<Base title={`${a.title} — Vault Human`} description={plainDek} image={ogImage}>
  <div class="wrap">
    <article class="article">
      {kind === 'essay' ? (
        <p class="amx"><a href="/writing/" class="backlink" style="margin:0;opacity:.7">Writing</a> &middot; {a.date}</p>
      ) : (
        <p class="amx"><a href="/writing/#letters" class="backlink" style="margin:0;opacity:.7">Writing</a> &middot; {a.date}</p>
      )}
      <h1>{a.title}</h1>
      {kind === 'essay' && <p class="adek">{a.dek}</p>}
      <div class="abody">
        {a.body.map((b) => b.k === "h" ? <h3 class="ah" set:html={b.t}></h3> : <p class={b.k} set:html={b.t}></p>)}
      </div>
      {vid && (
        <div class="lvid" id="film">
          <p class="lvid-k">Watch this key</p>
          <video controls playsinline preload="metadata" poster={vid.poster}><source src={vid.src} type="video/mp4" /></video>
        </div>
      )}
      {kind === 'essay' ? (
        <div class="article-cta">
          <p class="closing" style="font-size:22px">You were never a set of separate problems. One coach. One method. The whole of you.</p>
          <div class="ctarow">
            <a class="btn btn-acc" href="#" data-open-form>Begin with Vault</a>
            {pdf && <a class="btn btn-line" href={pdf} target="_blank" rel="noopener">Download the PDF</a>}
            <a class="btn btn-line" href="/writing/">More writing</a>
          </div>
        </div>
      ) : (
        <div class="article-cta">
          <p class="closing" style="font-size:22px">A coach. Every day. For the whole of you.</p>
          <div class="ctarow">
            <a class="btn btn-acc" href="#" data-open-form>Get the Vault Key, free</a>
            <a class="btn btn-line" href="/method/">How it works</a>
          </div>
          <nav class="lnav" aria-label="Letters">
            <span>{prev ? <a href={`/writing/${prev.slug}/`}>&larr; {prev.title}<small>{prev.date}</small></a> : <a href="/writing/#letters">&larr; All the letters</a>}</span>
            <span>{next ? <a href={`/writing/${next.slug}/`}>{next.title} &rarr;<small>{next.date}</small></a> : <a href="/writing/#letters">All the letters &rarr;</a>}</span>
          </nav>
        </div>
      )}
    </article>
  </div>
  <style is:inline>
    .lvid{margin:40px 0 8px}
    .lvid-k{font-family:var(--sans);font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--acc-soft);margin:0 0 10px}
    .lvid video{display:block;width:100%;max-width:560px;aspect-ratio:16/9;border-radius:12px;background:#000;border:1px solid rgba(143,166,126,.3)}
    .lnav{display:flex;justify-content:space-between;gap:16px;margin:30px 0 0;font-family:var(--sans);font-size:13px;text-align:left}
    .lnav a{text-decoration:none;opacity:.8}
    .lnav a:hover{opacity:1;text-decoration:underline}
    .lnav small{display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;opacity:.6;margin-top:3px}
    .lnav span:last-child{text-align:right}
    @media(max-width:600px){.lnav{flex-direction:column}}
  </style>
</Base>
