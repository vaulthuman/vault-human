---
// Paid-traffic landing page, rebuilt 10/24/26 from six expert reviews. One promise everywhere: your first week of coaching, free.
// First name + email → HubSpot form 3f225ab5 → /thanks (the Google Ads lead conversion fires there).
// Light, readable, no navigation. The hero is the product: the Day 1 email on a phone. No founder photo (Russ's rule).
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Online life coaching · your first week free · Vault Human</title>
  <meta name="description" content="A coach in your corner, every morning. One short lesson and one small step a day, from a real coach. Your first week is free, no card, no call." />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href="https://www.vaulthuman.com/start/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script is:inline>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD');
  </script>
  <style is:inline>
    :root{--paper:#F6F3EC;--paper2:#EEE9DF;--ink:#1B231D;--soft:#4A544C;--mute:#6E776F;--acc:#4F6B4C;--acc2:#8FA67E;--line:#D9D3C6;--dark:#121715}
    *{box-sizing:border-box}html,body{margin:0;background:var(--paper);color:var(--ink);font:18px/1.6 Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}
    .wrap{max-width:560px;margin:0 auto;padding:0 20px}
    .top{display:flex;justify-content:space-between;align-items:center;padding:16px 20px 4px}
    .brand{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:22px;letter-spacing:.01em;text-decoration:none;color:var(--ink)}.brand b{color:var(--acc);font-weight:600}
    .tel{font-weight:600;text-decoration:none;font-size:14px;color:var(--soft)}
    section{padding:34px 0}
    .eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:700;color:var(--acc);margin:0 0 10px}
    h1{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:clamp(34px,8.5vw,46px);line-height:1.08;margin:0 0 12px;letter-spacing:-.01em}
    h2{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:28px;line-height:1.15;margin:0 0 14px}
    .lede{font-size:18px;color:var(--soft);margin:0 0 20px}
    /* the product, on a phone */
    .phone{margin:4px auto 24px;width:min(300px,86%);background:#111;border-radius:34px;padding:12px;box-shadow:0 18px 40px rgba(27,35,29,.22)}
    .screen{background:#fff;border-radius:24px;overflow:hidden;font-size:13px;line-height:1.45;color:#222}
    .sbar{display:flex;justify-content:space-between;padding:8px 14px 0;font-size:11px;color:#555;font-weight:600}
    .mail{padding:10px 14px 14px}
    .mail .from{display:flex;align-items:center;gap:8px;margin:6px 0 4px}.mail .av{width:26px;height:26px;border-radius:50%;background:var(--acc);color:#fff;font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center}
    .mail .fn{font-weight:700;font-size:12.5px}.mail .fm{font-size:11px;color:#666}
    .mail .subj{font-weight:700;font-size:14px;margin:6px 0 8px;line-height:1.3}
    .mail p{margin:0 0 8px;font-size:12.5px}
    .mail .step{border:1.5px solid var(--acc2);border-radius:10px;padding:8px 10px;margin-top:6px;background:#F3F6EF}
    .mail .step b{display:block;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin-bottom:3px}
    .cap{font-size:13px;color:var(--mute);text-align:center;margin:-12px 0 18px}
    form{display:grid;gap:10px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px}
    label{font-size:13px;font-weight:600;letter-spacing:.02em;color:var(--soft)}
    input{width:100%;padding:14px 14px;border:1px solid #C9C2B4;border-radius:8px;background:#fff;color:var(--ink);font:17px Inter,system-ui,sans-serif}
    input:focus{outline:2px solid var(--acc);border-color:var(--acc)}
    .btn{display:block;width:100%;background:var(--acc);color:#fff;font-weight:700;border:0;padding:17px 22px;border-radius:8px;font-size:17px;cursor:pointer;font-family:Inter,sans-serif;margin-top:4px}
    .btn:disabled{opacity:.7}
    .under{font-size:14px;color:var(--mute);margin:10px 0 0;text-align:center}
    .err{color:#9a3b2e;font-size:14px;margin:6px 0 0;min-height:1em}
    .trust{display:flex;flex-wrap:wrap;gap:6px 18px;margin:14px 0 0;padding:0;list-style:none;font-size:14.5px;color:var(--soft)}
    .trust li:before{content:"✓";color:var(--acc);margin-right:6px;font-weight:700}
    .tint{background:var(--paper2)}
    .steps{display:grid;gap:14px;margin:0}
    .st{display:flex;gap:14px}.st .n{flex:0 0 32px;height:32px;border-radius:50%;background:var(--acc);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:14px}
    .st p{margin:0;color:var(--soft)}.st b{color:var(--ink)}
    .forme{list-style:none;margin:0;padding:0;display:grid;gap:10px}.forme li{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-family:Fraunces,Georgia,serif;font-size:19px;line-height:1.35;color:var(--ink)}
    .quotes{display:grid;gap:12px}
    .quotes figure{margin:0;background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px 16px 14px}
    .quotes blockquote{margin:0 0 8px;font-family:Fraunces,Georgia,serif;font-size:18px;line-height:1.4}
    .quotes figcaption{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--acc);font-weight:700}
    .fine{font-size:13.5px;color:var(--mute);margin:12px 0 0}
    .price{display:grid;gap:10px}
    .pr{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px}.pr b{display:block;font-size:17px}.pr span{display:block;font-size:26px;font-family:Fraunces,Georgia,serif;font-weight:600;margin:4px 0 6px}.pr p{margin:0;color:var(--soft);font-size:15.5px}
    footer{padding:26px 20px 34px;text-align:center;font-size:13px;color:var(--mute);border-top:1px solid var(--line)}
    footer a{text-decoration:none}
    @media (min-width:900px){.wrap{max-width:640px}.top{max-width:980px}#hero .wrap{max-width:980px;display:grid;grid-template-columns:1fr 360px;gap:0 56px;align-items:start}#hero .hc{grid-column:1}#hero .lede{margin-bottom:28px}#hero .hv{grid-column:2;grid-row:1/3;position:sticky;top:24px;padding-top:36px}#hero .phone{width:320px;margin:0 auto 18px}#hero .cap{margin:0}h1{font-size:48px}}
  </style>
</head>
<body>
  <div class="wrap top"><span class="brand">Vault <b>Human</b></span><a class="tel" href="tel:+18888332510">(888) 833-2510</a></div>

  <section id="hero"><div class="wrap">
    <div class="hc">
    <p class="eyebrow">Online life coaching</p>
    <h1>A coach in your corner, every morning.</h1>
    <p class="lede">One short lesson and one small step a day, from a real coach. For work, relationships, habits, and what's next. Your first week is free.</p>
    </div>
    <div class="hv">
    <div class="phone" aria-label="What arrives each morning"><div class="screen">
      <div class="sbar"><span>7:02 AM</span><span>▪▪▪ ◡ ▮</span></div>
      <div class="mail">
        <div class="from"><div class="av">V</div><div><div class="fn">Vault Human</div><div class="fm">to you · 7:02 AM</div></div></div>
        <div class="subj">Day 1 · Today I begin a new life.</div>
        <p>You don't need a new life. You need one habit that is yours, kept long enough to change your mind about who you are.</p>
        <p>You do not argue your way out of an old habit. You out-repeat it…</p>
        <div class="step"><b>Today's step</b>Read one page out loud, in your own voice, where no one is making you. Notice how it sounds.</div>
      </div>
    </div></div>
    <p class="cap">What arrives tomorrow at 7. Two minutes to read. One thing to do.</p>
    </div>
    <div class="hc">
    <form id="cap" novalidate>
      <div><label for="fn">First name</label><input id="fn" name="firstname" type="text" autocomplete="given-name" required /></div>
      <div><label for="em">Email</label><input id="em" name="email" type="email" autocomplete="email" inputmode="email" required /></div>
      <button class="btn" id="go" type="submit">Send me my first lesson, free</button>
      <p class="err" id="msg"></p>
    </form>
    <p class="under">Your first week is free. No card, no call. Cancel any time.</p>
    <ul class="trust"><li>Real coach, not an app</li><li>Private and online</li><li>Anywhere in the US</li></ul>
    </div>
  </div></section>

  <section class="tint" id="how"><div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2>Small enough to do. Daily enough to matter.</h2>
    <div class="steps">
      <div class="st"><span class="n">1</span><p><b>Your first lesson lands in minutes.</b> Then one every morning at 7, in your inbox and in a simple app.</p></div>
      <div class="st"><span class="n">2</span><p><b>Each one ends with one small step.</b> Some days it's a habit, some days a question, some days a conversation you've been avoiding.</p></div>
      <div class="st"><span class="n">3</span><p><b>A real coach is behind every one.</b> When you want more, there's a monthly live call, and private sessions if you choose.</p></div>
    </div>
  </div></section>

  <section id="forme"><div class="wrap">
    <p class="eyebrow">Is this for me?</p>
    <ul class="forme">
      <li>"I feel stuck, and I don't know where to start."</li>
      <li>"I've read the books. I need something that actually happens every day."</li>
      <li>"I don't want therapy. I want a coach."</li>
      <li>"I want to change something before another year goes by."</li>
    </ul>
  </div></section>

  <section class="tint" id="who"><div class="wrap">
    <p class="eyebrow">Who's behind it</p>
    <h2>Built by a coach who has spent two decades leading people.</h2>
    <p class="lede" style="margin:0">Vault Human was created by Russ Michaels, an attorney and trained coach, after twenty years leading teams and boards through hard decisions. The daily lessons are his. The coaching is about you, not him.</p>
  </div></section>

  <section id="people"><div class="wrap">
    <p class="eyebrow">From people who have worked with Russ</p>
    <div class="quotes">
      <figure><blockquote>He sees things in people they often can't see in themselves, and asks the questions no one else is willing to ask, with enough warmth that you actually want to answer.</blockquote><figcaption>Coaching client · CEO</figcaption></figure>
      <figure><blockquote>He draws people in, challenges how they think, and makes space for things that don't ordinarily get said. You leave thinking differently about yourself.</blockquote><figcaption>Workshop participant</figcaption></figure>
      <figure><blockquote>He can walk straight into the most uncomfortable conversation in the room without making anyone feel attacked, and leave everyone's dignity intact.</blockquote><figcaption>Board chair</figcaption></figure>
    </div>
    <p class="fine">Names withheld at their request. Shared with permission.</p>
  </div></section>

  <section class="tint" id="cost"><div class="wrap">
    <p class="eyebrow">What it costs</p>
    <div class="price">
      <div class="pr"><b>Membership</b><span>$99 a month</span><p>Your first week is free. The daily lessons, the app, and a monthly live coaching call. Cancel any time.</p></div>
      <div class="pr"><b>Private coaching</b><span>$999 a month</span><p>Three private sessions a month, with the membership included. Starts with a free call.</p></div>
    </div>
  </div></section>

  <section id="again"><div class="wrap">
    <h2>Start with one morning.</h2>
    <p class="lede">You don't have to decide about a year today. See whether one small step is useful.</p>
    <form id="cap2" novalidate>
      <div><label for="fn2">First name</label><input id="fn2" name="firstname" type="text" autocomplete="given-name" required /></div>
      <div><label for="em2">Email</label><input id="em2" name="email" type="email" autocomplete="email" inputmode="email" required /></div>
      <button class="btn" id="go2" type="submit">Send me my first lesson, free</button>
      <p class="err" id="msg2"></p>
    </form>
    <p class="under">Free week. No card. Unsubscribe any time.</p>
  </div></section>

  <footer>© {year} Vault Human, LLC · <a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a> · (888) 833-2510<br>Coaching, not therapy. Not legal, medical, financial or therapeutic advice.</footer>

  <script is:inline>
    (function(){
      function wire(fid,gid,mid){
        var f=document.getElementById(fid),go=document.getElementById(gid),msg=document.getElementById(mid),started=false;
        f.addEventListener('input',function(){if(!started){started=true;try{gtag('event','form_start',{form:fid})}catch(e){}}});
        f.addEventListener('submit',function(e){
          e.preventDefault();
          var fn=f.firstname.value.trim(),em=f.email.value.trim();
          if(!fn||!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)){f.reportValidity();msg.textContent=fn?'Please check the email address.':'Please add your first name.';return;}
          go.disabled=true;go.textContent='Sending…';msg.textContent='';
          var hutk=(document.cookie.match(/(?:^|; )hubspotutk=([^;]+)/)||[])[1];
          var ctx={pageUri:location.href,pageName:document.title};if(hutk)ctx.hutk=hutk;
          fetch('https://api-na2.hsforms.com/submissions/v3/integration/submit/246947446/3f225ab5-5a70-46d9-a497-29e6256b1e52',{
            method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({fields:[{name:'firstname',value:fn},{name:'email',value:em}],context:ctx})
          }).then(function(r){if(!r.ok)throw new Error(r.status);try{gtag('event','generate_lead',{method:'free_week'})}catch(_){}location.href='/thanks/';})
          .catch(function(){go.disabled=false;go.textContent='Send me my first lesson, free';msg.textContent="That didn't go through. Try again, or call (888) 833-2510.";});
        });
      }
      wire('cap','go','msg');wire('cap2','go2','msg2');
    })();
  </script>
</body>
</html>
