---
// Paid-traffic landing page, one screen (10/24/26). One promise, one action: the ad says "Your first key, free" and so does the page.
// First name + email → HubSpot form 3f225ab5 → /thanks (the Google Ads conversion fires there; /thanks offers the free call).
// Nothing else on the page: no nav, no plans, no FAQ. The daily keys and the welcome email carry the rest.
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Online life coaching · start free today · Vault Human</title>
  <meta name="description" content="Online life coaching. A coach sends you one short lesson and one small thing to do, every morning. Your first one is free, in your inbox in minutes." />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href="https://www.vaulthuman.com/start/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,500;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1653656120996-57c14eff3ee9?w=1200&q=70&auto=format&fit=crop" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script is:inline>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD');
  </script>
  <style is:inline>
    :root{--acc:#8FA67E;--bg:#121715;--ink:#F1EDE4;--muted:rgba(241,237,228,.78);--line:rgba(241,237,228,.18)}
    *{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.6 Inter,system-ui,sans-serif;min-height:100%}
    a{color:inherit}
    .page{position:relative;min-height:100vh;display:flex;flex-direction:column;background:#121715 url("https://images.unsplash.com/photo-1653656120996-57c14eff3ee9?w=1600&q=70&auto=format&fit=crop") 45% 35%/cover}
    .page:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,23,21,.45) 0%,rgba(18,23,21,.55) 35%,rgba(18,23,21,.94) 70%,#121715 100%)}
    .wrap{position:relative;z-index:2;max-width:560px;margin:0 auto;padding:0 20px;width:100%}
    .top{padding:18px 20px 0;display:flex;justify-content:space-between;align-items:center}
    .brand{font-family:"Bebas Neue",Impact,sans-serif;font-size:26px;letter-spacing:.06em;text-decoration:none}.brand b{color:var(--acc);font-weight:400}
    .tel{font-weight:600;text-decoration:none;font-size:14px;opacity:.9}
    main{flex:1;display:flex;align-items:flex-end}
    .card{padding:40px 20px 28px}
    .eyebrow{text-transform:uppercase;letter-spacing:.2em;font-size:12px;font-weight:700;color:#B3C6A3;margin:0 0 12px}
    h1{font-family:"Bebas Neue",Impact,sans-serif;font-weight:400;letter-spacing:.02em;line-height:.98;margin:0 0 14px;font-size:clamp(46px,11vw,72px)}
    h1 em{font-style:normal;color:var(--acc)}
    .lede{font-size:18px;line-height:1.5;color:var(--muted);margin:0 0 22px;max-width:46ch}
    form{display:grid;gap:10px}
    label{font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
    input{width:100%;padding:15px 16px;border:1px solid rgba(241,237,228,.35);border-radius:8px;background:rgba(18,23,21,.55);color:var(--ink);font:17px Inter,system-ui,sans-serif}
    input:focus{outline:2px solid var(--acc);border-color:var(--acc)}
    .btn{display:block;width:100%;background:var(--acc);color:#121715;font-weight:700;border:0;padding:18px 24px;border-radius:8px;font-size:15px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;font-family:Inter,sans-serif;margin-top:4px}
    .btn:disabled{opacity:.7}
    .trust{display:flex;flex-wrap:wrap;gap:8px 18px;margin:16px 0 0;padding:0;list-style:none;font-size:14px;color:var(--muted)}
    .trust li:before{content:"✓";color:var(--acc);margin-right:6px;font-weight:700}
    .err{color:#f0b4a8;font-size:14px;margin:8px 0 0;min-height:1em}
    blockquote{margin:30px 0 0;padding:0 0 0 14px;border-left:2px solid var(--acc);font-family:"Cormorant Garamond",Georgia,serif;font-size:19px;line-height:1.45;color:var(--ink)}
    blockquote cite{display:block;font-family:Inter,sans-serif;font-style:normal;font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:#B3C6A3;margin-top:8px}
    footer{position:relative;z-index:2;padding:18px 20px 26px;text-align:center;font-size:12px;color:rgba(241,237,228,.55)}
    footer a{text-decoration:none}
    @media (min-width:900px){.page{background-position:60% 40%}.wrap{margin-left:max(20px,calc((100% - 1080px)/2 + 20px))}}
  </style>
</head>
<body>
  <div class="page">
    <div class="wrap top"><span class="brand">Vault <b>Human</b></span><a class="tel" href="tel:+18888332510">(888) 833-2510</a></div>
    <main><div class="wrap card">
      <p class="eyebrow">Life coaching · online</p>
      <h1>Life coaching, online. <em>Start free today.</em></h1>
      <p class="lede">Here's how it works. Every morning, a coach sends you one short lesson and one small thing to do that day: about work, relationships, habits, or what's next. Your first one is free, in your inbox in minutes. Put in your name and email to get it.</p>
      <form id="cap" novalidate>
        <div><label for="fn">First name</label><input id="fn" name="firstname" type="text" autocomplete="given-name" required /></div>
        <div><label for="em">Email</label><input id="em" name="email" type="email" autocomplete="email" inputmode="email" required /></div>
        <button class="btn" id="go" type="submit">Send me my first lesson, free</button>
        <p class="err" id="msg"></p>
      </form>
      <ul class="trust"><li>Free to start. No card.</li><li>Online, anywhere in the US</li><li>A real coach, Russ Michaels</li><li>Unsubscribe any time</li></ul>
      <blockquote>I've walked into conversations with Russ feeling completely stuck and walked out wondering why the answer had seemed so far away.<cite>Business partner · names withheld at their request, shared with permission</cite></blockquote>
    </div></main>
    <footer>© {year} Vault Human, LLC · <a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a> · Coaching is not legal, medical, financial or therapeutic advice.</footer>
  </div>
  <script is:inline>
    (function(){
      var f=document.getElementById('cap'),go=document.getElementById('go'),msg=document.getElementById('msg');
      var started=false;
      f.addEventListener('input',function(){if(!started){started=true;try{gtag('event','form_start')}catch(e){}}});
      f.addEventListener('submit',function(e){
        e.preventDefault();
        var fn=f.firstname.value.trim(),em=f.email.value.trim();
        if(!fn||!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)){f.reportValidity();msg.textContent=fn?'Please check the email address.':'Please add your first name.';return;}
        go.disabled=true;go.textContent='Sending…';msg.textContent='';
        var hutk=(document.cookie.match(/(?:^|; )hubspotutk=([^;]+)/)||[])[1];
        var ctx={pageUri:location.href,pageName:document.title};if(hutk)ctx.hutk=hutk;
        fetch('https://api-na2.hsforms.com/submissions/v3/integration/submit/246947446/3f225ab5-5a70-46d9-a497-29e6256b1e52',{
          method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({fields:[{name:'firstname',value:fn},{name:'email',value:em}],context:ctx})
        }).then(function(r){if(!r.ok)throw new Error(r.status);try{gtag('event','generate_lead',{method:'first_lesson'})}catch(_){}location.href='/thanks/';})
        .catch(function(){go.disabled=false;go.textContent='Send me my first lesson, free';msg.textContent="That didn't go through. Try again, or call (888) 833-2510.";});
      });
    })();
  </script>
</body>
</html>
