<style is:inline>
.appr-split{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(0,1fr);gap:20px;align-items:stretch}
.appr-split .appr-wheel{max-width:none;display:flex;align-items:center;padding:24px 18px}
.appr-split .mtiles{display:flex;flex-direction:column;gap:16px;margin:0}
.appr-split .mtiles .pcard{flex:1 1 0;min-height:170px;padding:20px 22px}
.appr-split .mtiles .pcard b{font-size:clamp(26px,2.2vw,34px);margin:0}
.sec-prose{max-width:none;margin:32px 0 0;font-size:19px;line-height:1.6;color:rgba(241,237,228,.88);text-align:justify;text-align-last:left;hyphens:none}
.appr-cta{margin-top:26px}
.listen-prose{margin:0;font-size:clamp(20px,1.9vw,24px);line-height:1.55;color:rgba(241,237,228,.92);text-align:justify;text-align-last:left}
.tl{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;padding-bottom:16px;margin-bottom:30px}
.tl span{font-size:12px;letter-spacing:.22em;text-transform:uppercase;font-weight:700}
.tl span:not(.tl-flow):after{content:" \2192"}
.tl-past{color:#D2A576}.tl-now{color:#9DC0DE}.tl-fut{color:#A9C397}
.tl:before{content:"";position:absolute;left:0;right:12px;bottom:0;height:2px;background:linear-gradient(90deg,#B88A5E,#7FA3C2 50%,#8FA67E)}
.tl:after{content:"";position:absolute;right:0;bottom:-7px;border-left:16px solid #8FA67E;border-top:8px solid transparent;border-bottom:8px solid transparent}
.tl .tl-flow{position:absolute;left:0;right:16px;bottom:-1px;height:4px;background:repeating-linear-gradient(90deg,rgba(241,237,228,.85) 0 10px,transparent 10px 34px);opacity:.55;animation:tlflow 1.3s linear infinite}
@keyframes tlflow{from{background-position:0 0}to{background-position:34px 0}}
@media(prefers-reduced-motion:reduce){.tl .tl-flow{animation:none}}
#after .after{border-top:0;padding-top:0}
@media(max-width:900px){.appr-split{grid-template-columns:1fr}.appr-split .appr-wheel{padding:16px 6px}.appr-split .mtiles .pcard{min-height:200px}.sec-prose,.listen-prose{font-size:17px;text-align:left}.tl{gap:12px}}
.lkm{position:fixed;inset:0;z-index:210;display:none;align-items:center;justify-content:center;padding:20px}
.lkm.open{display:flex}
.lkm__bg{position:absolute;inset:0;background:rgba(8,10,9,.88);backdrop-filter:blur(4px)}
.lkm__card{position:relative;width:min(980px,100%);max-height:calc(100dvh - 40px);background:#141A16;border:1px solid rgba(241,237,228,.14);border-radius:14px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.6);color:#F1EDE4;display:flex;flex-direction:column}
.lkm__x{position:absolute;top:8px;right:10px;z-index:3;width:40px;height:40px;border:0;border-radius:50%;background:rgba(18,23,21,.75);color:#F1EDE4;font-size:26px;line-height:1;cursor:pointer}
.lkm__track{display:flex;transition:transform .4s ease;width:100%;flex:1 1 auto;min-height:0}
.lkm__slide{flex:0 0 100%;min-width:0;overflow-y:auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:min(560px,calc(100dvh - 150px));align-items:stretch}
.lkm__media{background:#0E1310;display:flex;align-items:center;justify-content:center;padding:28px}
.lkm__media img{max-width:100%;max-height:calc(100dvh - 230px);width:auto;height:auto;border-radius:6px;box-shadow:0 14px 34px rgba(0,0,0,.5)}
.lkm__media img.ph{border-radius:22px;border:6px solid #0B0F0C;max-height:min(500px,calc(100dvh - 230px))}
.lkm__media img.wide{width:100%;max-height:none;aspect-ratio:3/2;object-fit:cover;object-position:62% 50%;border-radius:10px}
.lkm__copy{display:flex;flex-direction:column;justify-content:center;padding:36px 40px 36px 12px}
.lkm__k{font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:#6CC0FF;font-weight:700;margin:0 0 10px}
.lkm__copy h3{font-family:"Bebas Neue",sans-serif;font-weight:400;font-size:clamp(34px,4vw,50px);line-height:.95;letter-spacing:.01em;margin:0 0 14px}
.lkm__copy p{margin:0 0 12px;font-size:17px;line-height:1.55;color:rgba(241,237,228,.88)}
.lkm__fine{font-size:12.5px!important;color:rgba(241,237,228,.6)!important}
.lkm__go{align-self:flex-start;margin-top:18px;border:0;cursor:pointer;background:#8FA67E;color:#121715;font:700 13px/1 Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase;padding:14px 20px;border-radius:6px}.lkm__go:hover{background:#A3B993}
.lkm__copy .dk-form{margin:8px 0 0;max-width:none}
.lkm__copy .dk-msg{margin:10px 0 0;min-height:1.2em;font-size:14px}
.lkm__more{display:inline-block;margin-top:14px;font-size:14px;color:rgba(241,237,228,.75);text-decoration:underline}
.lkm__nav{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 18px;border-top:1px solid rgba(241,237,228,.12);background:#101512}
.lkm__nav button{border:0;background:transparent;color:#F1EDE4;font:700 13px/1 inherit;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;padding:12px 8px;min-width:64px}
.lkm__nav button[disabled]{opacity:.25;cursor:default}
.lkm__dots{display:flex;gap:9px}
.lkm__dots i{width:9px;height:9px;border-radius:50%;background:rgba(241,237,228,.28);cursor:pointer;transition:background .2s}
.lkm__dots i.on{background:#6CC0FF}
@media(max-width:760px){.lkm{padding:10px}.lkm__card{max-height:calc(100dvh - 20px)}.lkm__slide{grid-template-columns:1fr;min-height:0;align-content:start}.lkm__media{padding:18px 18px 4px}.lkm__media img{max-height:32dvh}.lkm__media img.ph{max-height:32dvh}.lkm__media img.wide{max-height:32dvh;aspect-ratio:auto;object-fit:cover}.lkm__copy{padding:16px 22px 22px}.lkm__copy h3{font-size:34px}.lkm__copy p{font-size:16px}}
.lk-open .stickybar,.lk-open .vk-toast{display:none!important}
@media(max-width:760px){.lkm__ask .lkm__media{display:none}.lkm__ask .lkm__copy{padding-top:56px}}
@media(prefers-reduced-motion:reduce){.lkm__track{transition:none}}

.qt{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:52px}
.qt__i{position:relative;display:flex;align-items:center;justify-content:center;min-height:150px;border:1px solid rgba(241,237,228,.10);border-radius:10px;background:rgba(241,237,228,.025);overflow:hidden}
.qt__n,.qt__p{font:400 clamp(30px,3vw,44px)/1 "Bebas Neue",sans-serif;letter-spacing:.03em;white-space:nowrap}
.qt__n{color:rgba(241,237,228,.42);transition:none}
.qt__p{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);text-align:center;font-size:clamp(50px,4.8vw,70px);color:#F1EDE4;background:linear-gradient(90deg,#F1EDE4 0%,#C8DBB8 55%,#E2C9A6 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;-webkit-mask-image:linear-gradient(90deg,#000 45%,transparent 55%);mask-image:linear-gradient(90deg,#000 45%,transparent 55%);-webkit-mask-size:240% 100%;mask-size:240% 100%;-webkit-mask-position:100% 0;mask-position:100% 0;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat}
.qt.in .qt__p{animation:qtw 7.5s cubic-bezier(.5,0,.2,1) infinite;animation-delay:calc(var(--i)*1.1s)}
.qt.in .qt__n{animation:qtd 7.5s cubic-bezier(.5,0,.2,1) infinite;animation-delay:calc(var(--i)*1.1s)}
@keyframes qtw{0%,6%{-webkit-mask-position:100% 0;mask-position:100% 0}30%,84%{-webkit-mask-position:0 0;mask-position:0 0;opacity:1}94%,100%{-webkit-mask-position:0 0;mask-position:0 0;opacity:0}}
@keyframes qtd{0%,8%{opacity:1;filter:none}30%,84%{opacity:.07;filter:blur(2px)}96%,100%{opacity:1;filter:none}}
@media(max-width:760px){.qt{grid-template-columns:1fr;gap:12px;margin-top:36px}.qt__i{min-height:104px}}
@media(prefers-reduced-motion:reduce){.qt .qt__p{animation:none!important;-webkit-mask-image:none;mask-image:none}.qt .qt__n{animation:none!important;opacity:.07}}
</style>
</head>
