---
import '../styles/global.css';
import { firm, hero, plan, family, turn, paradox, why, about, speaking, speakingCredit, closing, footerLine } from '../data/site.js';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{firm.name} — Law · Life · Legacy</title>
  <meta name="description" content="Vault Human — law, life, and legacy evaluated as one connected system, in one relationship. In the age of a perfect advisor, we keep you the author of your own decisions." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) + HubSpot conversion listener -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
    gtag('js',new Date());gtag('config','AW-18371546487');
    window.addEventListener('message',function(e){if(e&&e.data&&e.data.type==='hsFormCallback'&&e.data.eventName==='onFormSubmitted'){gtag('event','conversion',{send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE'});gtag('event','generate_lead');}});
  </script>
</head>
<body>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href="/">{firm.wordmark}</a>
      <nav class="navlinks">
        <a href="/writing">Writing</a>
        <a href="/speaking">Speaking</a>
        <a class="navbtn" href="#" data-open-form>Start</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="wrap">
      <section class="hero">
        <p class="kicker">{firm.kicker}</p>
        <h1>{hero.h1}</h1>
        <p class="subline serif">{hero.subline}</p>
      </section>

      <div class="lede">
        {hero.lede.map((p) => <p>{p}</p>)}
      </div>

      <div class="cta"><a class="btn-fill" href="#" data-open-form>{hero.cta}</a></div>

      <hr class="rule" />

      <section class="plan">
        <h2 class="sec">{plan.eyebrow}</h2>
        <div class="cols three">
          {plan.steps.map((s) => (
            <div><h3><span class="stepnum">{s.n}</span> {s.title}</h3><p>{s.body}</p></div>
          ))}
        </div>
      </section>

      <hr class="rule" />

      <p class="turn">{turn}</p>

      <hr class="rule" />

      <section class="paradox">
        <h2 class="sec">{paradox.eyebrow}</h2>
        <p class="turn" style="margin-bottom:26px">{paradox.line}</p>
        <div class="prose">
          {paradox.body.map((p) => <p>{p}</p>)}
        </div>
        <p class="closing" style="margin-top:34px">{paradox.pull}</p>
      </section>

      <hr class="rule" />

      <h2 class="sec">Why Vault Human</h2>
      <div class="prose">
        {why.map((p) => <p>{p}</p>)}
      </div>

      <hr class="rule" />

      <section class="famwrap">
        <h2 class="sec">{family.label}</h2>
        <p class="turn" style="margin-bottom:12px">{family.intro}</p>
        <div class="cols two">
          {family.items.map((it) => (
            <div>
              <h3><a class="fam-link" style={it.color ? `color:${it.color}` : undefined} href={it.href} target={it.external ? "_blank" : undefined} rel={it.external ? "noopener" : undefined}>{it.name}{it.external ? " ↗" : ""}</a></h3>
              <p class="fam-tag">{it.tag}</p>
              <p>{it.body}</p>
            </div>
          ))}
        </div>
        <p class="closing" style="margin-top:34px">{family.close}</p>
      </section>

      <hr class="rule" />

      <section class="about">
        <h2 class="sec">{about.eyebrow}</h2>
        <img class="portrait" src={about.image} alt={`${about.name}, Founder of Vault Human`} width="120" height="150" style="width:120px;height:150px;object-fit:cover" />
        <p class="person-name">{about.name}</p>
        <div class="prose">
          {about.body.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <hr class="rule" />

      <p class="closing">{closing}</p>

      <div class="ctarow" id="begin">
        <a class="btn-fill" href="#" data-open-form>Start a conversation</a>
      </div>
    </div>
  </main>

  <footer class="site">
    <div class="wrap">
      <p class="sig">{firm.name.toUpperCase()}</p>
      <p class="meta">{footerLine} &middot; <a href="tel:+18888332510">(888)&nbsp;833-2510</a> &middot; &copy; {year}</p>
      <p class="meta"><a href={speakingCredit.href}>{speakingCredit.text}</a></p>
    </div>
  </footer>

  <!-- Start-a-conversation modal -->
  <div id="vh-modal" class="vh-modal" aria-hidden="true">
    <div class="vh-modal__bg" data-close-form></div>
    <div class="vh-modal__card" role="dialog" aria-modal="true" aria-label="Begin a conversation">
      <button class="vh-modal__x" type="button" data-close-form aria-label="Close">&times;</button>
      <h2 class="vh-modal__title">Begin a conversation</h2>
      <p class="vh-modal__sub">Share a few details and we&rsquo;ll be in touch &mdash; one relationship, one memory.</p>
      <div class="hs-form-frame" data-region="na2" data-form-id="3f225ab5-5a70-46d9-a497-29e6256b1e52" data-portal-id="246947446"></div>
    </div>
  </div>
  <script is:inline src="https://js-na2.hsforms.net/forms/embed/246947446.js" defer></script>
  <script is:inline>
  (function(){var m=document.getElementById('vh-modal');if(!m)return;
  function o(e){if(e)e.preventDefault();m.classList.add('is-open');m.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}
  function c(){m.classList.remove('is-open');m.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}
  document.addEventListener('click',function(e){var t=e.target.closest('[data-open-form]');if(t){o(e);return;}if(e.target.closest('[data-close-form]'))c();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')c();});})();
  </script>
<script>
addEventListener('DOMContentLoaded',function(){
 if(!('IntersectionObserver'in window))return;
 var s='main .wrap>section:not(.hero),main .wrap>h2,main .wrap>.prose,main .wrap>.lede,main .wrap>.cta,main .wrap>.ctarow,main .wrap>.turn,main .wrap>.closing,main .wrap>.why,main .wrap>.tags,main .wrap>.markets,main .wrap>.pkgs,main .wrap>.areas,main .wrap>.steps,main .wrap>.cols,main .wrap>.pagehead';
 var e=[].slice.call(document.querySelectorAll(s));
 e.forEach(function(x){x.classList.add('reveal')});
 var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('in');o.unobserve(y.target)}})},{threshold:0.06,rootMargin:'0px 0px -30px 0px'});
 e.forEach(function(x){o.observe(x)});
});
</script>

</body>
</html>
