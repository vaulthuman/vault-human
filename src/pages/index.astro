---
import '../styles/global.css';
import { firm, hero, pillars, family, turn, paradox, why, about, speaking, closing, footerLine } from '../data/site.js';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{firm.name} — Law · Life · Legacy</title>
  <meta name="description" content="Vault Human — law, life, and legacy evaluated as one connected system, in one relationship. In the age of a perfect advisor, we keep you the author of your own decisions." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href="/">{firm.wordmark}</a>
      <nav class="navlinks">
        <a href="/writing">Writing</a>
        <a href="/speaking">Speaking</a>
        <a class="navbtn" href={firm.bookingUrl}>Begin</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="wrap">
      <section class="hero">
        <p class="kicker">{firm.kicker}</p>
        <h1>{hero.h1}</h1>
        <p class="subline serif">{hero.subline}</p>
      </section>

      <div class="lede">
        {hero.lede.map((p) => <p>{p}</p>)}
      </div>

      <div class="cta"><a class="btn-fill" href={firm.bookingUrl}>{hero.cta}</a></div>

      <hr class="rule" />

      <section class="cols">
        {pillars.map((c) => (
          <div><h3>{c.title}</h3><p>{c.body}</p></div>
        ))}
      </section>

      <hr class="rule" />

      <p class="turn">{turn}</p>

      <hr class="rule" />

      <section class="paradox">
        <h2 class="sec">{paradox.eyebrow}</h2>
        <p class="turn" style="margin-bottom:26px">{paradox.line}</p>
        <div class="prose">
          {paradox.body.map((p) => <p>{p}</p>)}
        </div>
        <p class="closing" style="margin-top:34px">{paradox.pull}</p>
      </section>

      <hr class="rule" />

      <h2 class="sec">Why Vault Human</h2>
      <div class="prose">
        {why.map((p) => <p>{p}</p>)}
      </div>

      <hr class="rule" />

      <section class="famwrap">
        <h2 class="sec">{family.label}</h2>
        <div class="cols two">
          {family.items.map((it) => (
            <div>
              <h3><a class="fam-link" href={it.href} target={it.external ? "_blank" : undefined} rel={it.external ? "noopener" : undefined}>{it.name}{it.external ? " ↗" : ""}</a></h3>
              <p class="fam-tag">{it.tag}</p>
              <p>{it.body}</p>
            </div>
          ))}
        </div>
        <p class="closing" style="margin-top:34px">{family.close}</p>
      </section>

      <hr class="rule" />

      <section class="about">
        <h2 class="sec">{about.eyebrow}</h2>
        <img class="portrait" src={about.image} alt={`${about.name}, Founder of Vault Human`} width="230" height="288" />
        <p class="person-name">{about.name}</p>
        <div class="prose">
          {about.body.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <hr class="rule" />

      <section class="speaking">
        <h2 class="sec">{speaking.eyebrow}</h2>
        <p class="turn" style="margin-bottom:20px">{speaking.heading}</p>
        <p class="talk-meta">{speaking.talkMeta}</p>
        <p class="talk-title">{speaking.talkTitle}</p>
        <div class="prose"><p>{speaking.blurb}</p></div>
        <ul class="steps" style="margin-top:8px">
          {speaking.topics.map((t) => <li>{t}</li>)}
        </ul>
        <div class="cta" style="margin-top:36px"><a class="btn-line" href={`mailto:${firm.email}`}>{speaking.cta}</a></div>
      </section>

      <hr class="rule" />

      <p class="closing">{closing}</p>

      <div class="ctarow" id="begin">
        <a class="btn-fill" href={`mailto:${firm.email}`}>Begin a conversation</a>
      </div>
    </div>
  </main>

  <footer class="site">
    <div class="wrap">
      <p class="sig">{firm.name.toUpperCase()}</p>
      <p class="meta">{footerLine} &middot; <a href={`mailto:${firm.email}`}>{firm.email}</a> &middot; &copy; {year}</p>
    </div>
  </footer>
</body>
</html>
