---
import '../styles/global.css';
import { articles } from '../data/writing.js';
const fracture = articles.find((a) => a.slug === 'the-fracture');
const fxExcerpt = fracture.body.filter((b) => b.k !== 'h').slice(0, 1);
import { firm, hero, plan, family, turn, paradox, why, about, speaking, closing, footerLine } from '../data/site.js';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{firm.name} — Law · Life · Legacy</title>
<link rel="canonical" href="https://www.vaulthuman.com/">
<meta name="description" content="Law, life, and legacy evaluated as one connected system, in one relationship.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Vault Human">
<meta property="og:title" content="Vault Human — Law · Life · Legacy">
<meta property="og:description" content="Law, life, and legacy evaluated as one connected system, in one relationship.">
<meta property="og:image" content="https://www.vaulthuman.com/og-vaulthuman.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content="https://www.vaulthuman.com/">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Vault Human — Law · Life · Legacy">
<meta name="twitter:description" content="Law, life, and legacy evaluated as one connected system, in one relationship.">
<meta name="twitter:image" content="https://www.vaulthuman.com/og-vaulthuman.png">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) + HubSpot conversion listener -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};var gtag=window.gtag;
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD',{linker:{domains:['vaulthuman.com','tercetlaw.com','fretworksystems.com','triplicityadvisory.com','csh-vault.com']}});
    (function(){var fired=false;function fire(){if(fired)return;fired=true;gtag('event','conversion',{send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE'});gtag('event','generate_lead');}
    window.addEventListener('message',function(e){var d=e&&e.data;if(!d)return;if(typeof d==='string'){try{d=JSON.parse(d);}catch(_){return;}}if(!d||typeof d!=='object')return;var t=d.type||d.messageType||'',n=d.eventName||d.event||'';if(t==='hsFormCallback'&&(n==='onFormSubmitted'||n==='onFormSubmit'))fire();else if(n==='onFormSubmitted')fire();else if(d.accepted===true&&d.formGuid)fire();});
    window.addEventListener('hsFormCallback',function(e){if(e&&e.detail&&e.detail.eventName==='onFormSubmitted')fire();});})();
  </script>
<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"Organization","@id":"https://www.vaulthuman.com/#org","name":"Vault Human","url":"https://www.vaulthuman.com","telephone":"+1-888-833-2510","logo":"https://www.vaulthuman.com/og-vaulthuman.png","image":"https://www.vaulthuman.com/og-vaulthuman.png","description":"Vault Human is a family of professional practices - estate law, AI & systems, leadership coaching, and development advisory - held in one relationship.","founder":{"@type":"Person","@id":"https://www.vaulthuman.com/#russ","name":"Russ Michaels","alternateName":"Russ Michael Schmidtberger","jobTitle":"Founder","telephone":"+1-888-833-2510","worksFor":{"@id":"https://www.vaulthuman.com/#org"}},"sameAs":["https://www.linkedin.com/in/russ-michaels/"],"subOrganization":[{"@type":"LegalService","name":"Tercet Law","url":"https://www.tercetlaw.com"},{"@type":"ProfessionalService","name":"Fretwork Systems","url":"https://www.fretworksystems.com"},{"@type":"ProfessionalService","name":"Triplicity","url":"https://triplicityadvisory.com"},{"@type":"ProfessionalService","name":"CSH Vault Consulting","url":"https://www.csh-vault.com"}]}</script>
<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"Person","@id":"https://www.vaulthuman.com/#russ","name":"Russ Michaels","alternateName":"Russ Michael Schmidtberger","jobTitle":"Founder","telephone":"+1-888-833-2510","sameAs":["https://www.linkedin.com/in/russ-michaels/"],"worksFor":{"@id":"https://www.vaulthuman.com/#org"}}</script>
</head>
<body>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href="/">{firm.wordmark}</a>
      <nav class="navlinks">
        <a href="/writing">Writing</a>
        <a href="/speaking">Speaking</a>
        <a class="navbtn" href="#" data-open-form>Start</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="wrap">
      <section class="hero">
        <p class="kicker">{firm.kicker}</p>
        <h1>{hero.h1}</h1>
        <p class="subline serif">{hero.subline}</p>
      </section>

      <div class="lede">
        {hero.lede.map((p) => <p>{p}</p>)}
      </div>

      <div class="cta"><a class="btn-fill" href="#" data-open-form>{hero.cta}</a></div>

      <hr class="rule" />

      <section class="famwrap">
        <h2 class="sec">{family.label}</h2>
        <p class="turn" style="margin-bottom:12px">{family.intro}</p>
        <div class="cols two">
          {family.items.map((it) => (
            <div>
              <h3><a class="fam-link" style={it.color ? `color:${it.color}` : undefined} href={it.href} target={it.external ? "_blank" : undefined} rel={it.external ? "noopener" : undefined}>{it.name}{it.external ? " ↗" : ""}</a></h3>
              <p class="fam-tag">{it.tag}</p>
              <p>{it.body}</p>
            </div>
          ))}
        </div>
        <p class="closing" style="margin-top:34px">{family.close}</p>
      </section>

      <hr class="rule" />

      <section class="plan">
        <h2 class="sec">{plan.eyebrow}</h2>
        <div class="cols three">
          {plan.steps.map((s) => (
            <div><h3><span class="stepnum">{s.n}</span> {s.title}</h3><p>{s.body}</p></div>
          ))}
        </div>
      </section>

      <hr class="rule" />

      <section class="fracture" id="the-fracture">
        <h2 class="sec">Where this came from</h2>
        <p class="turn" style="margin-bottom:22px">The Fracture &mdash; the essay Vault Human was built on.</p>
        <div class="fx">
          {fxExcerpt.map((b) => <p class={b.k} set:html={b.t}></p>)}
          <p style="opacity:.6">&hellip;</p>
        </div>
        <div class="ctarow" style="margin-top:18px">
          <a class="btn-fill" href="#" data-open-essay>Read the essay</a>
          <a class="btn-line" href="/the-fracture.pdf" target="_blank" rel="noopener">Download the PDF</a>
        </div>
      </section>

      <hr class="rule" />

      <section class="about">
        <h2 class="sec">{about.eyebrow}</h2>
        <img class="portrait" src={about.image} alt={`${about.name}, Founder of Vault Human`} width="340" height="425" />
        <p class="person-name">{about.name}</p>
        <div class="prose">
          {about.body.map((p) => <p>{p}</p>)}
        </div>
        <div class="ctarow" style="margin-top:32px">
          <a class="btn-fill" href="/writing">Writing</a>
          <a class="btn-line" href="/speaking">Speaking</a>
        </div>
      </section>

      <hr class="rule" />

      <p class="turn">{turn}</p>

      <hr class="rule" />

      <section class="paradox">
        <h2 class="sec">{paradox.eyebrow}</h2>
        <p class="turn" style="margin-bottom:26px">{paradox.line}</p>
        <div class="prose">
          {paradox.body.map((p) => <p>{p}</p>)}
        </div>
        <p class="closing" style="margin-top:34px">{paradox.pull}</p>
      </section>

      <hr class="rule" />

      <h2 class="sec">Why Vault Human</h2>
      <div class="prose">
        {why.map((p) => <p>{p}</p>)}
      </div>

      <hr class="rule" />

      <p class="closing">{closing}</p>

      <div class="ctarow" id="begin">
        <a class="btn-fill" href="#" data-open-form>Start a conversation</a>
      </div>
    </div>
  </main>

  <footer class="site">
    <div class="wrap">
      <p class="sig">{firm.name.toUpperCase()}</p>
      <p class="meta">{footerLine} &middot; <a href="tel:+18888332510">(888)&nbsp;833-2510</a> &middot; &copy; {year}</p>
      <p class="meta"><a href="/writing">Writing</a> &middot; <a href="/speaking">Speaking</a> &middot; <a href="https://www.linkedin.com/in/russ-michaels/" target="_blank" rel="noopener" aria-label="Russ Michaels on LinkedIn"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false" style="vertical-align:-3px"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"/></svg><span style="margin-left:7px">LinkedIn</span></a></p>
    </div>
  </footer>

  <!-- The Fracture essay modal -->
  <div id="vh-essay" class="vh-modal" aria-hidden="true">
    <div class="vh-modal__bg" data-close-essay></div>
    <div class="vh-modal__card vh-modal__card--essay" role="dialog" aria-modal="true" aria-label="The Fracture">
      <button class="vh-modal__x" type="button" data-close-essay aria-label="Close">&times;</button>
      <p class="eyebrow" style="margin:0 0 10px">Vault Human &middot; Writing &middot; {fracture.date}</p>
      <h2>{fracture.title}</h2>
      <p class="edek">{fracture.dek}</p>
      <div class="ebody">
        {fracture.body.map((b) => b.k === 'h' ? <h3 set:html={b.t}></h3> : <p class={b.k} set:html={b.t}></p>)}
        <p style="margin-top:22px">&mdash; Russ Michaels</p>
      </div>
      <div class="eactions">
        <a class="btn-fill" href="#" data-open-form data-close-essay>Begin a conversation</a>
        <a class="btn-line" href="/the-fracture.pdf" target="_blank" rel="noopener">Download the PDF</a>
        <a class="btn-line" href="/writing">More writing</a>
      </div>
    </div>
  </div>
  <script is:inline>
  (function(){var m=document.getElementById('vh-essay');if(!m)return;
  function o(e){if(e)e.preventDefault();m.classList.add('is-open');m.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}
  function c(){m.classList.remove('is-open');m.setAttribute('aria-hidden','true');if(!document.querySelector('.vh-modal.is-open'))document.documentElement.style.overflow='';}
  document.addEventListener('click',function(e){var t=e.target.closest('[data-open-essay]');if(t){o(e);return;}if(e.target.closest('[data-close-essay]'))c();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')c();});
  if(location.hash==='#the-fracture-essay')o();})();
  </script>

  <!-- Start-a-conversation modal -->
  <div id="vh-modal" class="vh-modal" aria-hidden="true">
    <div class="vh-modal__bg" data-close-form></div>
    <div class="vh-modal__card" role="dialog" aria-modal="true" aria-label="Begin a conversation">
      <button class="vh-modal__x" type="button" data-close-form aria-label="Close">&times;</button>
      <h2 class="vh-modal__title">Begin a conversation</h2>
      <p class="vh-modal__sub">Share a few details and we&rsquo;ll be in touch &mdash; one relationship, one memory.</p>
      <div class="hs-form-frame" data-region="na2" data-form-id="3f225ab5-5a70-46d9-a497-29e6256b1e52" data-portal-id="246947446"></div>
    </div>
  </div>
  <script is:inline src="https://js-na2.hsforms.net/forms/embed/246947446.js" defer></script>
  <script is:inline>
  (function(){var m=document.getElementById('vh-modal');if(!m)return;
  function o(e){if(e)e.preventDefault();m.classList.add('is-open');m.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}
  function c(){m.classList.remove('is-open');m.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}
  document.addEventListener('click',function(e){var t=e.target.closest('[data-open-form]');if(t){o(e);return;}if(e.target.closest('[data-close-form]'))c();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')c();});})();
  </script>
<script>
addEventListener('DOMContentLoaded',function(){
 if(!('IntersectionObserver'in window))return;
 var s='main .wrap>section:not(.hero),main .wrap>h2,main .wrap>.prose,main .wrap>.lede,main .wrap>.cta,main .wrap>.ctarow,main .wrap>.turn,main .wrap>.closing,main .wrap>.why,main .wrap>.tags,main .wrap>.markets,main .wrap>.pkgs,main .wrap>.areas,main .wrap>.steps,main .wrap>.cols,main .wrap>.pagehead';
 var e=[].slice.call(document.querySelectorAll(s));
 e.forEach(function(x){x.classList.add('reveal')});
 var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('in');o.unobserve(y.target)}})},{threshold:0.06,rootMargin:'0px 0px -30px 0px'});
 e.forEach(function(x){o.observe(x)});
});
</script>

</body>
</html>
