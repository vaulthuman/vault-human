 349.8 L160.5 302.9 A104 104 0 0 0 197.1 339.5Z" fill="var(--w-more)"/><text class="wn" x="136.9" y="359.1">Rhythm</text><text class="wv" x="136.9" y="373.1">by Repeating</text><text class="wm" x="166.6" y="336.4">7</text><line class="wg" x1="198.0" y1="340.1" x2="152.0" y2="419.7"/><g transform="translate(140.0 440.5)"><rect x="-19" y="-12" width="38" height="24" rx="12" class="gbg"/><path d="M-13 6V-4M-4 6V-4M-13-4Q-8.5-8.5-4-4" class="gi"/><path d="M-4 5.5L-8 3.5V-3.5" class="gi gleaf"/><circle cx="4.5" cy="0" r="3.4" class="gi gk"/><path d="M7.9 0H15M12 0V3.2M15 0V3.2" class="gi gkey"/></g><path d="M79.2 346.2 A196 196 0 0 1 54.0 252.1 L146.0 251.1 A104 104 0 0 0 159.4 301.1Z" fill="var(--w-more)"/><text class="wn" x="95.5" y="287.4">Freedom</text><text class="wv" x="95.5" y="301.4">by Forgiving</text><text class="wm" x="136.0" y="283.5">8</text><line class="wg" x1="159.9" y1="302.0" x2="80.3" y2="348.0"/><g transform="translate(59.5 360.0)"><rect x="-19" y="-12" width="38" height="24" rx="12" class="gbg"/><path d="M-13 6V-4M-4 6V-4M-13-4Q-8.5-8.5-4-4" class="gi"/><path d="M-4 5.5L-8 3.5V-3.5" class="gi gleaf"/><circle cx="4.5" cy="0" r="3.4" class="gi gk"/><path d="M7.9 0H15M12 0V3.2M15 0V3.2" class="gi gkey"/></g><path d="M54.0 247.9 A196 196 0 0 1 79.2 153.8 L159.4 198.9 A104 104 0 0 0 146.0 248.9Z" fill="var(--w-more)"/><text class="wn" x="95.5" y="204.6">Future</text><text class="wv" x="95.5" y="218.6">by Planning</text><text class="wm" x="136.0" y="222.5">9</text><line class="wg" x1="146.0" y1="250.0" x2="54.0" y2="250.0"/><g transform="translate(30.0 250.0)"><rect x="-19" y="-12" width="38" height="24" rx="12" class="gbg"/><path d="M-13 6V-4M-4 6V-4M-13-4Q-8.5-8.5-4-4" class="gi"/><path d="M-4 5.5L-8 3.5V-3.5" class="gi gleaf"/><circle cx="4.5" cy="0" r="3.4" class="gi gk"/><path d="M7.9 0H15M12 0V3.2M15 0V3.2" class="gi gkey"/></g><path d="M81.3 150.2 A196 196 0 0 1 150.2 81.3 L197.1 160.5 A104 104 0 0 0 160.5 197.1Z" fill="var(--w-more)"/><text class="wn" x="136.9" y="132.9">Service</text><text class="wv" x="136.9" y="146.9">by Serving</text><text class="wm" x="166.6" y="169.6">10</text><line class="wg" x1="159.9" y1="198.0" x2="80.3" y2="152.0"/><g transform="translate(59.5 140.0)"><rect x="-19" y="-12" width="38" height="24" rx="12" class="gbg"/><path d="M-13 6V-4M-4 6V-4M-13-4Q-8.5-8.5-4-4" class="gi"/><path d="M-4 5.5L-8 3.5V-3.5" class="gi gleaf"/><circle cx="4.5" cy="0" r="3.4" class="gi gk"/><path d="M7.9 0H15M12 0V3.2M15 0V3.2" class="gi gkey"/></g><path d="M153.8 79.2 A196 196 0 0 1 247.9 54.0 L248.9 146.0 A104 104 0 0 0 198.9 159.4Z" fill="var(--w-more)"/><text class="wn" x="208.6" y="91.5">Sharing</text><text class="wv" x="208.6" y="105.5">by Showing</text><text class="wm" x="219.5" y="139.0">11</text><circle cx="250" cy="250" r="94" fill="var(--w-core)"/><text class="wc0" x="250" y="214">THE</text><text class="wc1" x="250" y="246">COACHING</text><text class="wc1" x="250" y="276">YEAR</text><text class="wc2" x="250" y="300">11 chambers · 9 gates</text></svg></div>
      <div class="wleg"><span><i style="background:#2C3B2C"></i>Chambers 1–5 · grounding yourself</span><span><i style="background:#26302B;outline:1px solid rgba(241,237,228,.25)"></i>Chambers 6–11 · more than yourself</span><span><i style="background:#E2C98A;border-radius:50%"></i>A gate, opened by keys</span></div>
    </div></section>
    <section class="sec" id="chambers"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The keys, chamber by chamber</p><h2>Every key has a room.</h2><p class="lede">The year moves through eleven chambers, one part of your life at a time, with a pause after the fifth to rest and integrate. Each chamber has its own focus. Open one to see what we coach and what you'll do.</p></div>
      <div class="ck">
        {chambers.map(c => c.rest ? (
          <div class="ck-row ck-rest"><span class="ck-m ck-pause" aria-hidden="true">‖</span><div class="ck-t"><b>Integration</b> <i>a pause, not a chamber</i><small>{c.asks}</small></div></div>
        ) : (
          <details class="ck-row"><summary><span class="ck-m">{String(c.n).padStart(2,'0')}</span><div class="ck-t"><b>{c.chamber}</b> <i>by {c.verb}</i><small>{c.title}</small></div><span class="ck-n">{c.mind.length} keys</span></summary>
            <div class="ck-body"><p class="ck-q">{c.asks}</p>
              <div class="ck-ask"><div><span>What we coach</span><ul>{c.mindThemes.map(x => <li>{x}</li>)}</ul></div><div><span>What you'll do</span><ul>{c.mindPractice.map(x => <li>{x}</li>)}</ul></div></div>
              <div class="ck-reel" aria-label="Ideas your coach draws on in this chamber"><span>Ideas your coach draws on</span><div class="ck-track"><div class="ck-run" style={`animation-duration:${Math.round(c.mind.reduce((a,k)=>a+k.length+4,0)/5.2)}s`}>{c.mind.map(k => <em>{k}</em>)}</div><div class="ck-run" style={`animation-duration:${Math.round(c.mind.reduce((a,k)=>a+k.length+4,0)/5.2)}s`} aria-hidden="true">{c.mind.map(k => <em>{k}</em>)}</div></div></div>
            </div>
          </details>
        ))}
      </div>
    </div></section>
    <section class="sec final"><div class="wrap"><h2>You never hunt for keys.</h2><p class="lede">They come to you in order, one a morning, with a coach beside you.</p><div class="ctarow"><a class="btn btn-acc" href="#" data-open-form>Begin with Vault</a><a class="btn btn-line" href="/the-180/">The 180 · keys for the body</a></div></div></section>
  </main>
  <footer class="site"><div class="wrap foot">
    <div><a class="brand" href="/">Vault <b>Human</b></a><p>Daily coaching with Russ Michaels.</p><p><a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a> · <a href="tel:+18888332510">(888) 833-2510</a></p></div>
