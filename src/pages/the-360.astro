---
import '../styles/home.css';
import '../styles/nature.css';
import chambers from '../data/chambers.json';
const year = new Date().getFullYear();

---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>The 360 — Vault Human</title><link rel="canonical" href="https://www.vaulthuman.com/the-360/">
  <meta name="description" content="The 360 keys for the mind behind Vault Human coaching, placed chamber by chamber across the coaching year.">
  <meta property="og:title" content="The 360 — Vault Human"><meta property="og:description" content="The 360 keys for the mind behind Vault Human coaching, placed chamber by chamber across the coaching year."><meta property="og:image" content="https://www.vaulthuman.com/og-vaulthuman.png"><meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:wght@500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) + HubSpot conversion listener -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};var gtag=window.gtag;
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD',{linker:{domains:['vaulthuman.com','tercetlaw.com','fretworksystems.com','triplicityadvisory.com']}});
    (function(){var fired=false;function fire(){if(fired)return;fired=true;gtag('event','conversion',{send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE'});gtag('event','generate_lead');}
    window.addEventListener('message',function(e){var d=e&&e.data;if(!d)return;if(typeof d==='string'){try{d=JSON.parse(d);}catch(_){return;}}if(!d||typeof d!=='object')return;var t=d.type||d.messageType||'',n=d.eventName||d.event||'';if(t==='hsFormCallback'&&(n==='onFormSubmitted'||n==='onFormSubmit'))fire();else if(n==='onFormSubmitted')fire();else if(d.accepted===true&&d.formGuid)fire();});
    window.addEventListener('hsFormCallback',function(e){if(e&&e.detail&&e.detail.eventName==='onFormSubmitted')fire();});})();
  </script>
  <style is:inline>:root{--pagebg:url("https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1800&q=55&auto=format&fit=crop")}</style>
</head>
<body data-time="all">
  <header class="site"><div class="wrap bar"><a class="brand" href="/">Vault <b>Human</b></a><nav class="navlinks" id="navlinks"><div class="navdrop"><button class="navdrop__btn" type="button" aria-expanded="false" aria-haspopup="true">The approach <span aria-hidden="true">▾</span></button><div class="navdrop__menu"><a href="/#how">How it works</a><a href="/method/">The method</a><a href="/the-360/">The 360 · keys for the mind</a><a href="/the-180/">The 180 · keys for the body</a><a href="/#listened">Listening</a><span class="navdrop__rule"></span><a href="/as-learned/">As learned · the past</a><a href="/as-loved/">As loved · the present</a><a href="/as-lived/">As lived · the future</a></div></div><a href="/#pricing">Pricing</a><a href="/#russ">About Russ</a><a href="/speaking/">Speaking</a><a class="btn btn-acc" href="#" data-open-form>Begin</a></nav><button class="navtoggle" type="button" aria-label="Open menu" aria-controls="navlinks" aria-expanded="false"><span></span><span></span><span></span></button></div></header>
  <main>
    <section class="hero"><div class="wrap">
      <p class="eyebrow">The 360 · keys for the mind</p>
      <h1>Three hundred sixty keys. <em>Each in its place.</em></h1>
      <p class="lede">We gathered 360 of the ways people have learned to grow, from ancient practice to modern psychology, and placed each one in the part of your life where it does the most good. Your coach hands you one each morning, inside the chamber you're in, and helps you put it to work.</p>
      <div class="ctarow"><a class="btn btn-acc" href="#" data-open-form>Begin with Vault</a><a class="btn btn-line" href="#chambers">See the chambers</a></div>
    </div></section>
    <section class="sec" style="padding-top:20px"><div class="wrap">
      <div class="ck-steps">
        <div><span>01</span><b>It arrives</b><p>Your Vault Key comes each morning, from the chamber you're in.</p></div>
        <div><span>02</span><b>You use it</b><p>One thing to do today: a practice, a call, a page, a walk.</p></div>
        <div><span>03</span><b>You log it</b><p>One line: what you did and what it did.</p></div>
        <div><span>04</span><b>It turns</b><p>When it becomes a habit, the key turns and the gate swings open.</p></div>
      </div>
    </div></section>
    <section class="sec" id="chambers"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The keys, chamber by chamber</p><h2>Every key has a room.</h2><p class="lede">The year moves through eleven chambers, one part of your life at a time, with a pause after the fifth to rest and integrate. Each chamber holds its own keys. Open one to see what it asks of you.</p></div>
      <div class="ck">
        {chambers.map(c => c.rest ? (
          <div class="ck-row ck-rest"><span class="ck-m ck-pause" aria-hidden="true">‖</span><div class="ck-t"><b>Integration</b> <i>a pause, not a chamber</i><small>{c.asks}</small></div></div>
        ) : (
          <details class="ck-row"><summary><span class="ck-m">{String(c.n).padStart(2,'0')}</span><div class="ck-t"><b>{c.chamber}</b> <i>by {c.verb}</i><small>{c.title}</small></div><span class="ck-n">{c.mind.length} keys</span></summary>
            <div class="ck-body"><div class="ck-ask"><p><span>What this chamber asks</span>{c.asks}</p><p><span>What a key asks of you</span>{c.mindDo}</p></div>
            <ul class="ck-keys">{c.mind.map(k => <li>{k}</li>)}</ul></div>
          </details>
        ))}
      </div>
    </div></section>
    <section class="sec final"><div class="wrap"><h2>You never hunt for keys.</h2><p class="lede">They come to you in order, one a morning, with a coach beside you.</p><div class="ctarow"><a class="btn btn-acc" href="#" data-open-form>Begin with Vault</a><a class="btn btn-line" href="/the-180/">The 180 · keys for the body</a></div></div></section>
  </main>
  <footer class="site"><div class="wrap foot">
    <div><a class="brand" href="/">Vault <b>Human</b></a><p>Daily coaching with Russ Michaels.</p><p><a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a> · <a href="tel:+18888332510">(888) 833-2510</a></p></div>
    <ul><li><a href="/method/">The method</a></li><li><a href="/the-360/">The 360 · mind</a></li><li><a href="/the-180/">The 180 · body</a></li><li><a href="/as-learned/">As Learned</a></li><li><a href="/as-loved/">As Loved</a></li><li><a href="/as-lived/">As Lived</a></li><li><a href="/#pricing">Pricing</a></li><li><a href="/writing">Writing</a></li><li><a href="/speaking/">Speaking</a></li></ul>
    <ul><li><a href="https://www.fretworksystems.com">Fretwork Systems</a> · automation</li><li><a href="https://triplicityadvisory.com">Triplicity Advisory</a> · leadership coaching</li><li><a href="https://www.tercetlaw.com">Tercet Law</a> · wills and trusts</li></ul>
  </div><div class="wrap legal"><span>&copy; {year} Vault Human, LLC. Coaching is not legal, medical, financial or therapeutic advice.</span><span>Learn · Love · Live · Listen</span></div></footer>
  <div id="vh-modal" class="vh-modal" aria-hidden="true"><div class="vh-modal__bg" data-close-form></div><div class="vh-modal__card" role="dialog" aria-modal="true" aria-label="Begin your year with Vault"><button class="vh-modal__x" type="button" data-close-form aria-label="Close">&times;</button><h2 class="vh-modal__title">Begin your year with Vault</h2><p class="vh-modal__sub">Tell us a little about you. Your Vault coach will write back personally, and tomorrow at 7 a.m. your first key arrives: a short teaching and one small practice to start your first chamber. Your first week is on us.</p><div class="hs-form-frame" data-region="na2" data-form-id="3f225ab5-5a70-46d9-a497-29e6256b1e52" data-portal-id="246947446"></div></div></div>
  <script is:inline src="https://js-na2.hsforms.net/forms/embed/246947446.js" defer></script>
  <script is:inline>
  (function(){var m=document.getElementById('vh-modal');if(!m)return;function o(e){if(e)e.preventDefault();m.classList.add('is-open');m.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}function c(){m.classList.remove('is-open');m.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}document.addEventListener('click',function(e){var t=e.target.closest('[data-open-form]');if(t){o(e);return;}if(e.target.closest('[data-close-form]'))c();});document.addEventListener('keydown',function(e){if(e.key==='Escape')c();});})();
  addEventListener('DOMContentLoaded',function(){document.body.classList.add('ready');if(!('IntersectionObserver'in window))return;var e=[].slice.call(document.querySelectorAll('.sec .wrap > *'));e.forEach(function(x){x.classList.add('reveal')});var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('in');o.unobserve(y.target)}})},{threshold:0.08,rootMargin:'0px 0px -30px 0px'});e.forEach(function(x){o.observe(x)});});
  </script>
<script is:inline>(function(){var b=document.querySelector(".navtoggle"),n=document.getElementById("navlinks");if(!b||!n)return;function set(o){document.body.classList.toggle("nav-open",o);b.setAttribute("aria-expanded",o?"true":"false");b.setAttribute("aria-label",o?"Close menu":"Open menu");}b.addEventListener("click",function(){set(!document.body.classList.contains("nav-open"));});n.addEventListener("click",function(e){if(e.target.closest("a"))set(false);});document.addEventListener("keydown",function(e){if(e.key==="Escape")set(false);});})();</script>
<div class="dk-pop" id="dk-pop" aria-hidden="true">
  <div class="dk-pop__bg" data-dk-close></div>
  <div class="dk-pop__card" role="dialog" aria-modal="true" aria-labelledby="dk-pop-title">
    <button class="dk-pop__x" type="button" data-dk-close aria-label="Close">&times;</button>
    <svg class="dk-icon" viewBox="0 0 64 64" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M32 6v7M32 51v7M6 32h7M51 32h7M13.6 13.6l5 5M45.4 45.4l5 5M13.6 50.4l5-5M45.4 18.6l5-5"/><circle cx="26" cy="32" r="7"/><path d="M33 32h16M44 32v5M48 32v4"/></g></svg>
    <h2 class="dk-title" id="dk-pop-title">The Vault Key</h2>
    <p class="dk-sub">Free guidance from Russ in your inbox, five mornings a week. One short teaching, one small practice.</p>
    <form class="dk-form" novalidate><label class="dk-sr" for="dk-email-pop">Email</label><input id="dk-email-pop" type="email" name="email" placeholder="Email" autocomplete="email" required /><button type="submit">Subscribe</button></form>
    <p class="dk-fine">Free. Unsubscribe any time. We never share your email.</p>
    <p class="dk-msg" aria-live="polite"></p>
  </div>
</div>
<script is:inline>
(function(){
  if(window.__dkInit)return;window.__dkInit=true;
  var URL='https://api.hsforms.com/submissions/v3/integration/submit/246947446/3f225ab5-5a70-46d9-a497-29e6256b1e52';
  function get(k){try{return localStorage.getItem(k)}catch(e){return null}}
  function put(k,v){try{localStorage.setItem(k,v)}catch(e){}}
  function bind(){
    document.querySelectorAll('.dk-form').forEach(function(f){
      if(f.__b)return;f.__b=true;
      f.addEventListener('submit',function(e){
        e.preventDefault();var inp=f.querySelector('input'),msg=f.parentNode.querySelector('.dk-msg'),btn=f.querySelector('button');
        var v=(inp.value||'').trim();
        if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)){msg.textContent='Please enter a valid email address.';inp.focus();return;}
        btn.disabled=true;msg.textContent='Sending…';
        fetch(URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({fields:[{name:'email',value:v},{name:'message',value:'Vault Key subscriber'}],context:{pageUri:location.href,pageName:'Vault Key signup · '+document.title}})})
        .then(function(r){if(!r.ok)throw 0;put('dk_sub','1');f.style.display='none';msg.textContent='You’re in. Your first key arrives tomorrow morning.';try{gtag('event','sign_up',{method:'daily_key'})}catch(_){};})
        .catch(function(){btn.disabled=false;msg.innerHTML='That didn’t go through. Try again, or write to <a href="mailto:vault@vaulthuman.com">vault@vaulthuman.com</a>.';});
      });
    });
  }
  function init(){
    bind();
    var p=document.getElementById('dk-pop');if(!p)return;
    function open(){if(get('dk_sub'))return;var last=+get('dk_seen')||0;if(Date.now()-last<14*864e5)return;var m=document.getElementById('vh-modal');if(m&&m.classList.contains('is-open'))return;if(document.body.classList.contains('nav-open'))return;put('dk_seen',String(Date.now()));p.classList.add('is-open');p.setAttribute('aria-hidden','false');}
    function close(){p.classList.remove('is-open');p.setAttribute('aria-hidden','true');}
    p.addEventListener('click',function(e){if(e.target.closest('[data-dk-close]'))close();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});
    var t=setTimeout(open,30000);
    addEventListener('scroll',function s(){var h=document.documentElement;if(performance.now()>20000&&(h.scrollTop+innerHeight)/h.scrollHeight>0.55){removeEventListener('scroll',s);clearTimeout(t);open();}},{passive:true});
    document.addEventListener('mouseout',function(e){if(!e.relatedTarget&&e.clientY<=0)open();});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script is:inline>(function(){var h=document.querySelector("header.site");function f(){if(h)h.classList.toggle("scrolled",scrollY>40)}addEventListener("scroll",f,{passive:true});f();document.querySelectorAll(".navdrop__btn").forEach(function(b){b.addEventListener("click",function(e){e.stopPropagation();var d=b.parentNode,o=!d.classList.contains("open");d.classList.toggle("open",o);b.setAttribute("aria-expanded",o?"true":"false")})});document.addEventListener("click",function(e){document.querySelectorAll(".navdrop.open").forEach(function(d){if(!d.contains(e.target)){d.classList.remove("open");d.querySelector(".navdrop__btn").setAttribute("aria-expanded","false")}})});})();</script>
</body></html>
