    <section class="sec" id="chambers"><div class="wrap">
      <div class="sec-head"><p class="eyebrow">The keys, chamber by chamber</p><h2>Every key has a room.</h2><p class="lede">Eleven chambers, one part of your life at a time.</p></div>
      <div class="ck">
        {chambers.map(c => c.rest ? (
          <div class="ck-row ck-rest"><span class="ck-m ck-pause" aria-hidden="true">‖</span><div class="ck-t"><b>Integration</b> <i>a pause, not a chamber</i><small>{c.asks}</small></div></div>
        ) : (
          <details class="ck-row"><summary><span class="ck-m">{String(c.n).padStart(2,'0')}</span><div class="ck-t"><b>{c.chamber}</b> <i>by {c.verb}</i><small>{c.title}</small></div><span class="ck-n">{c.mind.length} keys</span></summary>
            <div class="ck-body"><p class="ck-q">{c.asks}</p>
              <div class="ck-reel" aria-label="Ideas your coach draws on in this chamber"><span>Ideas your coach draws on</span><div class="ck-track"><div class="ck-run" style={`animation-duration:${Math.round(c.mind.reduce((a,k)=>a+k.length+4,0)/5.2)}s`}>{c.mind.map(k => <em>{k}</em>)}</div><div class="ck-run" style={`animation-duration:${Math.round(c.mind.reduce((a,k)=>a+k.length+4,0)/5.2)}s`} aria-hidden="true">{c.mind.map(k => <em>{k}</em>)}</div></div></div>
            </div>
          </details>
        ))}
      </div>
    </div></section>
    <section class="sec final"><div class="wrap"><h2>You never hunt for keys.</h2><p class="lede">They come to you in order, one a morning, with a coach beside you.</p><div class="ctarow"><a class="btn btn-acc" href="#" data-open-form>Begin with Vault</a><a class="btn btn-line" href="/the-180/">The 180 · keys for the body</a></div></div></section>
