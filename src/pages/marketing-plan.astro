<div class="card"><h3>Members</h3><svg viewBox='0 0 480 240' class='chart' role='img' aria-label='Members over time'><line x1='40' x2='362' y1='210.0' y2='210.0' class='gl'/><text x='32' y='214.0' class='ax' text-anchor='end'>0</text><line x1='40' x2='362' y1='163.9' y2='163.9' class='gl'/><text x='32' y='167.9' class='ax' text-anchor='end'>200</text><line x1='40' x2='362' y1='117.8' y2='117.8' class='gl'/><text x='32' y='121.8' class='ax' text-anchor='end'>400</text><line x1='40' x2='362' y1='71.6' y2='71.6' class='gl'/><text x='32' y='75.6' class='ax' text-anchor='end'>600</text><line x1='40' x2='362' y1='25.5' y2='25.5' class='gl'/><text x='32' y='29.5' class='ax' text-anchor='end'>800</text><line x1='119.3' x2='119.3' y1='14' y2='210.0' stroke='#A8823A' stroke-dasharray='4 4'/><text x='125.3' y='26' class='lb2' fill='#A8823A'>Mar 2–7</text><polyline points='40.0,208.9 64.8,207.8 89.5,206.5 114.3,204.8 139.1,202.9 163.8,200.8 188.6,198.5 213.4,196.1 238.2,193.5 262.9,190.8 287.7,188.0 312.5,184.9 337.2,181.8 362.0,178.6' fill='none' stroke='#9AA39B' stroke-width='2'/><text x='372.0' y='183.6' class='lb' fill='#9AA39B'>Floor · 136</text><polyline points='40.0,207.5 64.8,198.3 89.5,188.4 114.3,177.9 139.1,166.5 163.8,154.9 188.6,142.6 213.4,129.2 238.2,114.6 262.9,98.8 287.7,82.1 312.5,64.7 337.2,46.6 362.0,28.5' fill='none' stroke='#B88A5E' stroke-width='2'/><text x='372.0' y='33.5' class='lb' fill='#B88A5E'>Stretch · 787</text><polyline points='40.0,207.8 64.8,201.3 89.5,194.3 114.3,190.1 139.1,183.9 163.8,176.3 188.6,167.3 213.4,157.0 238.2,146.2 262.9,134.9 287.7,122.9 312.5,110.4 337.2,97.5 362.0,84.5' fill='none' stroke='#5F7A5B' stroke-width='4'/><text x='372.0' y='89.5' class='lb' fill='#5F7A5B'>Plan · 544</text><text x='40.0' y='230' class='ax' text-anchor='middle'>Nov ’26</text><text x='114.3' y='230' class='ax' text-anchor='middle'>Feb ’27</text><text x='188.6' y='230' class='ax' text-anchor='middle'>May ’27</text><text x='262.9' y='230' class='ax' text-