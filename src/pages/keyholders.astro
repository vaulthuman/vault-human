---
// Keyholders — an unlisted page for people Russ invites. Not in the nav or sitemap.
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>For our Keyholders — Vault Human</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="An invitation to see what Vault Human is building, and to walk it with us." />
  <meta property="og:title" content="For our Keyholders — Vault Human" /><meta property="og:description" content="A coach every day. For the whole of you. An invitation to see what we are building." /><meta property="og:image" content="https://www.vaulthuman.com/og-vaulthuman.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Fraunces:ital,wght@0,400;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script is:inline>
    window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};var gtag=window.gtag;
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD');
  </script>
  <style is:inline>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{--bg:#101511;--bg2:#141a16;--card:#171e19;--line:#263028;--ink:#EDEBE4;--soft:#c9cdc6;--mute:#8f988f;--sage:#8FA67E;--past:#D2A576;--now:#9DC0DE;--fut:#A9C397}
    html{scroll-behavior:smooth}
    body{background:var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased;line-height:1.6}
    img{display:block;max-width:100%}
    a{color:inherit;text-decoration:none}
    .wrap{max-width:1080px;margin:0 auto;padding:0 24px}
    section{padding:96px 0}
    .alt{background:var(--bg2)}
    .eyebrow{font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--sage);font-weight:600;margin-bottom:14px}
    h1,h2{font-family:'Bebas Neue',sans-serif;font-weight:400;letter-spacing:.5px;line-height:.95}
    h1{font-size:clamp(56px,9vw,112px)}
    h2{font-size:clamp(40px,6vw,66px);margin-bottom:18px}
    h3{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:26px;letter-spacing:.6px;margin-bottom:6px}
    p{font-size:16px;color:var(--soft)}
    .lede{font-size:20px;line-height:1.5;color:var(--ink)}
    .serif{font-family:Fraunces,serif;font-style:italic}
    .bar{height:3px;width:64px;border-radius:2px;background:var(--sage);margin:24px 0}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
    .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px}
    .card p{font-size:15px}
    .num{font-family:'Bebas Neue';font-size:54px;color:var(--sage);line-height:1}
    .tile{border-radius:14px;overflow:hidden;border:1px solid var(--line);background:var(--card)}
    .tile .ph{aspect-ratio:4/3;background-size:cover;background-position:center 25%}
    .tile .t{padding:18px 20px}
    .tile .t p{font-size:14.5px}
    .hero{position:relative;min-height:92vh;display:flex;align-items:flex-end;padding:0 0 80px;background:url(https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=2000&q=80&auto=format&fit=crop) center/cover}
    .hero:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,13,11,.2) 0%,rgba(10,13,11,.5) 45%,rgba(10,13,11,.97) 100%)}
    .hero .wrap{position:relative;z-index:2}
    .topbar{position:absolute;top:0;left:0;right:0;z-index:3;display:flex;justify-content:space-between;align-items:center;padding:28px 24px;max-width:1080px;margin:0 auto}
    .brand{font-family:'Bebas Neue';font-size:24px;letter-spacing:6px}
    .brand b{color:var(--sage);font-weight:400}
    .topbar a.site{font-size:11px;letter-spacing:3px;color:var(--soft)}
    .letter{display:grid;grid-template-columns:300px 1fr;gap:56px;align-items:start}
    .letter img{border-radius:12px;width:100%}
    .letter p{font-size:17px;margin-bottom:18px}
    .why{position:relative;background:url(https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=2000&q=80&auto=format&fit=crop) center 35%/cover}
    .why:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,21,17,.35),rgba(16,21,17,.97) 65%)}
    .why .wrap{position:relative;z-index:2;padding-top:30vh}
    table{width:100%;border-collapse:collapse;font-size:15px}
    th{text-align:left;font-weight:600;color:var(--sage);font-size:11px;letter-spacing:2px;text-transform:uppercase;padding:12px;border-bottom:1px solid #2c352e}
    td{padding:13px 12px;border-bottom:1px solid #222a24;color:var(--soft);vertical-align:top}
    td b{color:var(--ink)}
    .cap{font-size:12.5px;color:var(--mute);margin-top:10px;line-height:1.4}
    .phone{border-radius:22px;border:2px solid var(--line);overflow:hidden}
    .svgw svg{width:100%;height:auto}
    .coachgrid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;grid-template-rows:290px 290px;gap:14px}
    .coachgrid .wide{grid-column:2/5}
    .coachgrid > div{border-radius:12px;overflow:hidden;position:relative}
    .coachgrid img,.coachgrid video{width:100%;height:100%;object-fit:cover;object-position:center 25%}
    .coachgrid .big{grid-row:1/3}
    .vid{position:relative;border-radius:16px;overflow:hidden;background:#000;aspect-ratio:16/9}
    .vid video{width:100%;height:100%;display:block}
    .fine{padding:120px 0 60px}
    .fine p{font-size:12px;color:var(--mute);max-width:820px;line-height:1.6}
    .step{display:flex;gap:18px;align-items:flex-start}
    .step .num{font-size:40px;min-width:40px}
    .arrows{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin:36px 0 28px}
    .ar{position:relative;padding:16px 22px 14px 30px;clip-path:polygon(0 0,calc(100% - 22px) 0,100% 50%,calc(100% - 22px) 100%,0 100%,22px 50%);background:var(--card);border:1px solid var(--line);text-align:center;animation:arpulse 4.8s ease-in-out infinite}
    .ar:first-child{clip-path:polygon(0 0,calc(100% - 22px) 0,100% 50%,calc(100% - 22px) 100%,0 100%)}
    .ar b{display:block;font-family:'Bebas Neue';font-weight:400;font-size:24px;letter-spacing:3px}
    .ar span{font-size:12.5px;letter-spacing:2px;text-transform:uppercase;color:var(--soft)}
    .ar.past{--c:var(--past)}.ar.now{--c:var(--now);animation-delay:1.6s}.ar.fut{--c:var(--fut);animation-delay:3.2s}
    .ar b{color:var(--c)}
    @keyframes arpulse{0%,60%,100%{background:var(--card)}15%,35%{background:color-mix(in srgb,var(--c) 22%,var(--card))}}
    .wheelbox{background:#121715;border:1px solid var(--line);border-radius:16px;padding:28px 24px 12px}
    @media (max-width:700px){
      .wheelbox{padding:10px 0 2px;margin:0 -12px;border-radius:12px;transform:perspective(900px) rotateX(16deg);transform-origin:50% 62%}
      .wheel .wn{font-size:15.5px}.wheel .wv{font-size:11.5px}.wheel .wm{font-size:11px}
      .wheel text.wal{font-size:30px}.wheel text.wals{font-size:15px}.wheel text.wal-start{font-size:21px}.wheel text.wal-in{font-size:21px}
      .wheel .wc1{font-size:38px}.wheel .wc0{font-size:13px}.wheel .wc2{font-size:13px}
      .wheel text.wal-in{display:none}.wheel text.wals{font-size:13px}
    }
    .wheel{width:100%;height:auto;display:block;--w-self:#3A4F36;--w-now:#2F3A30;--w-more:#26302B;--w-past:#4A3B2C;--w-present:#2B3A47;--w-future:#2F4430;--w-rest:#1A201C;--w-core:#121715}
    .wheel text{text-anchor:middle;font-family:Inter,system-ui,sans-serif}
    .wn{font-size:13px;font-weight:600;fill:#F1EDE4}.wn.rest{fill:rgba(241,237,228,.6)}
    .wv{font-size:9.5px;fill:#B3C6A3}.wm{font-size:9px;fill:rgba(241,237,228,.55)}
    .wg{stroke:#F1EDE4;stroke-width:2}
    .gbg{fill:#121715;stroke:rgba(241,237,228,.4)}
    .gi{fill:none;stroke:#F1EDE4;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
    .gleaf{stroke:#B3C6A3}.gkey{stroke:#E2C98A}.gi.gk{stroke:#E2C98A}
    .wc0{font-size:11px;letter-spacing:.35em;fill:#B3C6A3}
    .wc1{font-family:"Bebas Neue",Inter,sans-serif;font-size:30px;fill:#F1EDE4;letter-spacing:.03em;font-weight:400}
    .wc2{font-size:11px;fill:rgba(241,237,228,.65)}
    .wheel .wa{fill:none;stroke-width:3;stroke-linecap:round}
    .wheel .wa-in{stroke:url(#wa-grad);stroke-width:4}
    .wheel .wa-past{stroke:#B88A5E}.wheel .wa-now{stroke:#7FA3C2}.wheel .wa-fut{stroke:#8FA67E}.wheel .wa-start{fill:#B88A5E;stroke:#121715;stroke-width:3}.wheel text.wal-start{fill:#D9B48C;font-size:18px}
    .wheel text.wal{font-family:"Bebas Neue",Inter,sans-serif;font-size:24px;letter-spacing:.06em;fill:#F1EDE4}
    .wheel text.wal-in{fill:#C9B79A;font-size:20px}
    .wheel text.wals{font-size:13px;fill:rgba(241,237,228,.72)}
    .wheel a:hover text.wal{fill:#B3C6A3}
    .wheel .wa-flow{fill:none;stroke:#F1EDE4;stroke-width:4;stroke-linecap:round;stroke-dasharray:2 22;opacity:.55;animation:wa-flow 1.6s linear infinite}
    @keyframes wa-flow{to{stroke-dashoffset:-24}}
    @media(prefers-reduced-motion:reduce){.wheel .wa-flow,.ar{animation:none}}
    .under{margin:28px 0 0}
    .keyrow{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:40px;align-items:start}
    .keyrow img{width:100%;border-radius:14px}
    .keytext{margin-top:22px}
    .duo{margin-top:36px}
    .ph{position:relative}
    .inset{position:absolute;right:18px;bottom:-1px;width:26%;border-radius:12px 12px 0 0;border:2px solid var(--line);border-bottom:0;box-shadow:0 10px 30px rgba(0,0,0,.5)}
    .who{margin-top:32px}
    .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,21,17,.15),rgba(16,21,17,.55))}
    .inset.two{width:31%;right:auto}
    .inset.a{left:16%}.inset.b{left:53%}
    .mail{position:absolute;left:6%;right:6%;bottom:-1px;background:rgba(246,241,232,.72);backdrop-filter:blur(2px);color:#1F2A33;border-radius:10px 10px 0 0;padding:14px 18px 16px;font-size:13px;line-height:1.5;box-shadow:0 12px 30px rgba(0,0,0,.5)}
    .mail .mh{font-size:12px;color:#4A5B6B;border-bottom:1px solid #e3ddd1;padding:3px 0}
    .mail .mh span{display:inline-block;width:58px;color:#8f988f;letter-spacing:1px;text-transform:uppercase;font-size:10px}
    .mail .mb{padding-top:10px;font-family:Fraunces,serif;font-size:14px}
    .soon{font-family:Inter;font-size:11px;letter-spacing:2px;color:var(--sage);vertical-align:middle;margin-left:6px}
    .cite{font-size:13px;color:var(--mute);margin-top:22px;line-height:1.6}
    .pop{color:var(--now)!important;font-weight:600;margin-top:12px;border-top:1px solid var(--line);padding-top:10px}
    .cap-card{border-left:3px solid var(--now)}
    .cap-card p{color:#C7DCEC}
    .cap-card .calc{margin-top:10px;font-size:14px;color:#9DC0DE}
    .cite a{color:var(--soft);text-decoration:underline;text-decoration-color:var(--line)}

    .wheelrow{grid-template-columns:1.15fr 1fr;gap:40px;align-items:center}
    @media (max-width:860px){
      section{padding:72px 0}
      .grid2,.grid3,.grid4{grid-template-columns:1fr 1fr}
      .letter{grid-template-columns:1fr}
      .letter img{max-width:260px}
      .coachgrid{grid-template-columns:1fr 1fr 1fr;grid-template-rows:260px 200px 170px}
      .coachgrid .big{grid-column:1/4;grid-row:1}
      .coachgrid .wide{grid-column:1/4;grid-row:2}
      .hero{min-height:80vh}
    }
    @media (max-width:560px){
      .grid2,.grid3,.grid4{grid-template-columns:1fr}
      .coachgrid{grid-template-columns:1fr 1fr 1fr;grid-template-rows:220px 160px 140px}
      .keyrow{grid-template-columns:1fr}
      .arrows{gap:6px} .ar{padding:12px 10px 10px 18px} .ar b{font-size:18px;letter-spacing:2px} .ar span{font-size:10px}
      .wheelbox{padding:12px 6px 4px}
      h2{font-size:44px}
      .lede{font-size:18px}
    }
  </style>
</head>
<body>

<header class="hero">
  <div class="topbar"><a class="brand" href="/">VAULT <b>HUMAN</b></a><a class="site" href="https://www.vaulthuman.com/">VAULTHUMAN.COM</a></div>
  <div class="wrap">
    <p class="eyebrow">For our Keyholders</p>
    <h1>A coach every day.<br><span style="color:var(--sage)">For the whole of you.</span></h1>
    <div class="bar"></div>
    <p class="serif" style="font-size:24px;color:var(--ink)">An invitation to see what we are building, and to walk it with us.</p>
  </div>
</header>

<section id="letter">
  <div class="wrap letter">
    <div>
      <img src="/russ-michaels.jpg" alt="Russ Michaels" />
      <p class="cap">Russ Michaels<br>Founder, Vault Human</p>
    </div>
    <div>
      <p class="eyebrow">A letter</p>
      <h2>Dear Keyholder,</h2>
      <p style="color:var(--ink)">Thank you for opening this. Before I show you anything, I want you to know why it exists.</p>
      <p>Most of us were handed the pieces of ourselves, never the whole. A little advice here, a lesson there, a hard season we walked through alone. We learned to get by. Very few of us were ever taught how to grow on purpose, a day at a time, with someone in our corner.</p>
      <p>I have spent more than twenty years leading organizations and sitting with people in the moments that shape them. What I have seen, over and over, is that people are far bigger than the stories they have been told about themselves. When someone feels heard, seen and believed in, they rise. Almost always.</p>
      <p>Vault Human is my answer to that. Each morning, a short key arrives: something to learn, something to love, something to live. You take one small step. You write down what you notice. A coach walks beside you. Over a year, it comes full circle, and you come home to more of yourself.</p>
      <p>And here is the part that moves me most. When one person grows, everyone who loves them feels it. A mother who finally feels heard. A teenager who learns early that his voice matters. A father who finds his footing again. A team that starts telling each other the truth. That is how the world gets kinder: one person, one day, one key at a time.</p>
      <p>You are receiving this because you are someone I trust to see it early. I would love for you to walk it with us.</p>
      <p class="serif" style="font-size:24px;color:var(--ink);margin-top:28px">With gratitude,<br>Russ</p>
    </div>
  </div>
</section>

<section class="why">
  <div class="wrap">
    <p class="eyebrow">Why we exist</p>
    <h1 style="font-size:clamp(48px,7vw,92px)">To be big, not small.<br><span style="color:var(--sage)">Empowered, not disempowered.</span></h1>
    <p class="lede" style="margin-top:22px">We believe every person carries more than they have been told. Vault Human exists to help people grow into it, and to finish each day a little more of who they are.</p>
    <div class="grid3" style="margin-top:40px">
      <div class="card" style="border-top:3px solid var(--past)"><h3 style="color:var(--past)">To be seen</h3><p>Your past honored, not erased. What shaped you becomes something you can work with.</p></div>
      <div class="card" style="border-top:3px solid var(--now)"><h3 style="color:var(--now)">To be heard</h3><p>Your voice in the present, all the way to the end of what you have to say.</p></div>
      <div class="card" style="border-top:3px solid var(--fut)"><h3 style="color:var(--fut)">To be empowered</h3><p>Your future, chosen on purpose and lived into, one day at a time.</p></div>
    </div>
  </div>
</section>

<section id="who">
  <div class="wrap">
    <p class="eyebrow">Who it is for</p>
    <h2>Life does not wait<br>until we are ready.</h2>
    <p class="lede">Picture the people you love. One of them is carrying something right now.</p>
    <div class="grid2" style="margin-top:36px">
      <div class="tile"><div class="ph" style="background-image:url(https://images.unsplash.com/photo-1475609471617-0ef53b59cff5?w=1000&q=80&auto=format&fit=crop);background-position:center 18%"></div><div class="t"><h3>The mother</h3><p>She gives all day and goes to bed last. Ten quiet minutes each morning become the one place where someone asks how <i>she</i> is, and listens.</p></div></div>
      <div class="tile"><div class="ph" style="background-image:url(https://images.unsplash.com/photo-1758272959140-e727ef77bbda?w=1200&q=80&auto=format&fit=crop);background-position:center 30%"></div><div class="t"><h3>The teenager</h3><p>Sixteen, and the world is loud. A daily key teaches him to notice his own mind, to speak up, and to trust that he is more than a screen says he is.</p></div></div>
      <div class="tile"><div class="ph" style="background-image:url(https://images.unsplash.com/photo-1616587894289-86480e533129?w=1200&q=80&auto=format&fit=crop);background-position:center 30%"></div><div class="t"><h3>The father</h3><p>Steady for everyone else, unsure inside. A coach on a call, a page to write on, and a path that does not ask him to have it all figured out.</p></div></div>
      <div class="tile"><div class="ph" style="background-image:url(https://images.unsplash.com/photo-1752659504423-87916d12bc37?w=1200&q=80&auto=format&fit=crop);background-position:center 30%"></div><div class="t"><h3>The team</h3><p>Talented people, talking past each other. When a team walks the same keys together, they start listening, and the work gets lighter.</p></div></div>
    </div>
  </div>
</section>

<section class="alt" id="get-1">
  <div class="wrap">
    <p class="eyebrow">What you get · one</p>
    <h2>You get your life back.</h2>
    <p class="lede">Your past, your present and your future, held together instead of in pieces, in one year that moves through all three. The year moves through eleven chambers, one part of your life at a time. Each gate opens when a daily practice stops being something you try and becomes something you live. Gates, not dates.</p>
    <div class="arrows" aria-hidden="true">
      <div class="ar past"><b>Past</b><span>Learn</span></div>
      <div class="ar now"><b>Present</b><span>Love</span></div>
      <div class="ar fut"><b>Future</b><span>Live</span></div>
    </div>
    <div class="wheelbox"><div class="appr-wheel"><svg class="wheel" viewBox="-175 -40 870 610" role="img" aria-label="The Vault Approach: an arrow comes in from the left to where you start, at the top, and the line wraps the year, through past (chambers 1 to 4), present (5 to 8, with a pause after Healing) and future (9 to 11)."><defs><marker id="wa-past" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#B88A5E"/></marker><marker id="wa-now" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#7FA3C2"/></marker><marker id="wa-fut" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#8FA67E"/></marker><marker id="wa-head" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5.2" markerHeight="5.2" orient="auto"><path d="M0 0L10 5L0 10z" fill="#D9A877"/></marker><linearGradient id="wa-grad" gradientUnits="userSpaceOnUse" x1="-160" x2="244" y1="0" y2="0"><stop offset="0" stop-color="#B3C6A3" stop-opacity=".35"/><stop offset="1" stop-color="#B88A5E"/></linearGradient></defs><path class="wa wa-in" d="M-160 -2 H226" marker-end="url(#wa-head)"/><path class="wa-flow" d="M-160 -2 H222"/><circle cx="250" cy="-2" r="7" class="wa-start"/><text class="wal wal-start" x="250" y="-18">START WITH YOU</text><text class="wal wal-in" x="-160" y="-16" style="text-anchor:start">THE VAULT APPROACH</text><path class="wa wa-past" d="M258.8 -1.8 A252 252 0 0 1 472.5 368.3"/><path class="wa wa-now" d="M463.7 383.5 A252 252 0 0 1 -1.8 258.8"/><path class="wa wa-fut" d="M-1.8 241.2 A252 252 0 0 1 241.2 -1.8"/><a href="/as-learned/"><text class="wal" x="497" y="119" style="text-anchor:start">PAST</text><text class="wals" x="497" y="135" style="text-anchor:start">Learning your past · 1–4</text></a><a href="/as-loved/"><text class="wal" x="173" y="519" style="text-anchor:middle">PRESENT</text><text class